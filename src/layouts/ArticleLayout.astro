---
/**
 * ArticleLayout.astro — Article-specific layout
 * Includes reading progress bar activation, author block, related articles strip.
 */
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import AuthorBlock from '../components/AuthorBlock.astro';
import Footer from '../components/Footer.astro';
import type { Article } from '../lib/cms';
import { getArticleUrl } from '../lib/cms';

interface Props {
  article: Article;
  relatedArticles?: Article[];
  sectionName?: string;
  sectionHref?: string;
}

const { article, relatedArticles = [], sectionName, sectionHref } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(article._createdDate));

const hasRealCoverImage = Boolean(article.coverImage && !article.coverImage.includes('/images/logo.png'));
---

<Base
  title={article.title}
  description={`${article.title} — ${sectionName ?? 'The Suture'}`}
  ogImage={article.coverImage}
>
  <Nav />

  <main id="main-content">
    <article class={`article-page ${!hasRealCoverImage ? 'article-page--no-cover' : ''}`}>

      <!-- Hero cover (Hidden as fallback if no real cover photo is provided) -->
      {hasRealCoverImage && (
        <div class="article-cover">
          <img
            src={article.coverImage}
            alt={article.title}
            class="article-cover__img"
            loading="eager"
            decoding="async"
            onerror="this.parentElement.style.display='none'"
          />
          <div class="article-cover__gradient"></div>
        </div>
      )}

      <div class="container--narrow">

        <!-- Breadcrumb -->
        {sectionName && (
          <nav class="article-breadcrumb" aria-label="Breadcrumb">
            <a href="/suture" class="article-breadcrumb__link">The Suture</a>
            <span class="article-breadcrumb__sep" aria-hidden="true">·</span>
            {sectionHref && (
              <a href={sectionHref} class="article-breadcrumb__link">{sectionName}</a>
            )}
          </nav>
        )}

        <!-- Header -->
        <header class="article-header" data-reveal>
          <p class="eyebrow">{sectionName}</p>
          <h1 class="article-header__title">{article.title}</h1>

          <div class="article-header__meta">
            <AuthorBlock
              author={article.author}
              authorPhoto={article.authorPhoto}
              date={formattedDate}
            />
          </div>
        </header>

        <!-- Article Body Content -->
        <div class="article-body" data-reveal data-delay="200">
          <slot />
        </div>

        <!-- Author Signature Block -->
        {article.author && (
          <div class="article-signature" data-reveal>
            <div class="article-signature__header">
              {article.authorPhoto && (
                <img
                  src={article.authorPhoto}
                  alt={article.author}
                  class="article-signature__photo"
                  onerror="this.style.display='none'"
                />
              )}
              <div class="article-signature__meta">
                <span class="article-signature__label">Written By</span>
                <h3 class="article-signature__name">{article.author}</h3>
              </div>
            </div>
            {article.authorDescription && (
              <p class="article-signature__bio">{article.authorDescription}</p>
            )}
          </div>
        )}

      </div>

      <!-- Related articles -->
      {relatedArticles.length > 0 && (
        <section class="article-related section-py">
          <div class="container">
            <h2 class="article-related__heading" data-reveal>More from {sectionName}</h2>
            <div class="article-related__grid">
              {relatedArticles.slice(0, 3).map((rel, i) => (
                <a
                  href={getArticleUrl(rel)}
                  class="article-related__card"
                  data-reveal
                  data-delay={String(i * 100)}
                >
                  {rel.coverImage && (
                    <div class="article-related__img-wrap">
                      <img src={rel.coverImage} alt={rel.title} loading="lazy" decoding="async" />
                    </div>
                  )}
                  <h3 class="article-related__title">{rel.title}</h3>
                  {rel.author && <p class="article-related__author">{rel.author}</p>}
                </a>
              ))}
            </div>
          </div>
        </section>
      )}
    </article>
  </main>

  <!-- Unified Full-Screen Lightbox Modal -->
  <div class="image-lightbox" id="image-lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close Lightbox">&times;</button>
    <div class="lightbox-content">
      <img src="" alt="" id="lightbox-img" />
      <p id="lightbox-caption" class="lightbox-caption"></p>
    </div>
  </div>

  <Footer />
</Base>

<!-- Reading progress bar & Unified Photo Lightbox handler -->
<script>
  // Reading progress bar activation
  const bar = document.getElementById('reading-progress');
  if (bar) {
    const body = document.querySelector('.article-body') as HTMLElement;
    const update = () => {
      if (!body) return;
      const rect = body.getBoundingClientRect();
      const start = window.scrollY + rect.top;
      const end = start + body.offsetHeight - window.innerHeight;
      const pct = Math.min(100, Math.max(0, ((window.scrollY - start) / (end - start)) * 100));
      bar.style.width = pct + '%';
      bar.setAttribute('aria-valuenow', String(Math.round(pct)));
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  // Auto-generate Section Slideshow Navigator at top of article body
  const articleBody = document.querySelector('.article-body') as HTMLElement | null;
  if (articleBody) {
    const sectionTargets = Array.from(articleBody.querySelectorAll('h2, h3, [data-section-divider]')) as HTMLElement[];
    if (sectionTargets.length > 1) {
      const slideshowBar = document.createElement('div');
      slideshowBar.className = 'article-section-slideshow';

      sectionTargets.forEach((el, idx) => {
        if (!el.id) el.id = `article-section-${idx + 1}`;
      });

      const getSectionTitle = (el: HTMLElement, idx: number) => {
        let raw = el.textContent || '';
        let clean = raw.replace('Previous Section', '').replace('Next Section', '').replace('Article Section', '').trim();
        return clean || `Section ${idx + 1}`;
      };

      slideshowBar.innerHTML = `
        <button type="button" class="section-nav-arrow prev" aria-label="Previous Section" title="Previous Section">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div class="section-slideshow__info">
          <span class="section-slideshow__counter">Section <span class="current-sec">1</span> of <span class="total-sec">${sectionTargets.length}</span></span>
          <span class="section-slideshow__title">${getSectionTitle(sectionTargets[0], 0)}</span>
        </div>
        <button type="button" class="section-nav-arrow next" aria-label="Next Section" title="Next Section">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      `;

      articleBody.insertBefore(slideshowBar, articleBody.firstChild);

      let currentSectionIdx = 0;
      const currentSecEl = slideshowBar.querySelector('.current-sec');
      const titleEl = slideshowBar.querySelector('.section-slideshow__title');
      const prevBtn = slideshowBar.querySelector('.section-nav-arrow.prev');
      const nextBtn = slideshowBar.querySelector('.section-nav-arrow.next');

      const updateSlideshowState = (index: number) => {
        currentSectionIdx = Math.max(0, Math.min(index, sectionTargets.length - 1));
        if (currentSecEl) currentSecEl.textContent = String(currentSectionIdx + 1);
        if (titleEl) titleEl.textContent = getSectionTitle(sectionTargets[currentSectionIdx], currentSectionIdx);
      };

      const navigateToSection = (index: number) => {
        updateSlideshowState(index);
        sectionTargets[currentSectionIdx]?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };

      prevBtn?.addEventListener('click', () => navigateToSection(currentSectionIdx - 1));
      nextBtn?.addEventListener('click', () => navigateToSection(currentSectionIdx + 1));

      // Scroll Spy using IntersectionObserver to update section slideshow state dynamically
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const idx = sectionTargets.indexOf(entry.target as HTMLElement);
              if (idx !== -1) updateSlideshowState(idx);
            }
          });
        },
        { rootMargin: '-10% 0px -70% 0px', threshold: 0 }
      );

      sectionTargets.forEach((target) => observer.observe(target));
    }
  }

  // Single Unified Lightbox modal for all article photos & galleries
  const lightbox = document.getElementById('image-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxClose = document.getElementById('lightbox-close');

  if (lightbox && lightboxImg) {
    const openLightbox = (src: string, caption?: string) => {
      lightboxImg.src = src;
      lightboxImg.alt = caption || 'Article photo';
      if (lightboxCaption) lightboxCaption.textContent = caption || '';
      lightbox.classList.add('image-lightbox--open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      lightbox.classList.remove('image-lightbox--open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      lightboxImg.src = '';
    };

    lightboxClose?.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || (e.target as HTMLElement).classList.contains('lightbox-close')) {
        closeLightbox();
      }
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target) return;

      // Handle Gallery Slider prev/next track scrolling
      const sliderBtn = target.closest('.slider-btn') as HTMLElement | null;
      if (sliderBtn) {
        const sliderWrap = sliderBtn.closest('[data-gallery-slider]');
        if (!sliderWrap) return;
        const track = sliderWrap.querySelector('.article-gallery-slider__track') as HTMLElement | null;
        if (track) {
          const scrollAmount = track.clientWidth * 0.75;
          const isNext = sliderBtn.classList.contains('next');
          track.scrollBy({
            left: isNext ? scrollAmount : -scrollAmount,
            behavior: 'smooth'
          });
        }
        return;
      }

      // Handle Gallery Panorama prev/next track scrolling
      const panoramaBtn = target.closest('.panorama-nav-btn') as HTMLElement | null;
      if (panoramaBtn) {
        const panoramaWrap = panoramaBtn.closest('[data-gallery-panorama]');
        if (!panoramaWrap) return;
        const track = panoramaWrap.querySelector('.panorama-track') as HTMLElement | null;
        if (track) {
          const scrollAmount = track.clientWidth * 0.8;
          const isNext = panoramaBtn.classList.contains('next');
          track.scrollBy({
            left: isNext ? scrollAmount : -scrollAmount,
            behavior: 'smooth'
          });
        }
        return;
      }

      // Handle Slide to Prev Section divider button click
      const slidePrevBtn = target.closest('[data-action="slide-prev-section"]') as HTMLElement | null;
      if (slidePrevBtn) {
        const currentDivider = slidePrevBtn.closest('[data-section-divider]');
        if (!currentDivider) return;
        const allDividers = Array.from(document.querySelectorAll('.article-body [data-section-divider], .article-body h2, .article-body h3'));
        const currentIdx = allDividers.indexOf(currentDivider as HTMLElement);
        const prevTarget = allDividers[Math.max(0, currentIdx - 1)] as HTMLElement | undefined;
        if (prevTarget) {
          prevTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        return;
      }

      // Handle Slide to Next Section divider button click
      const slideNextBtn = target.closest('[data-action="slide-next-section"]') as HTMLElement | null;
      if (slideNextBtn) {
        const currentDivider = slideNextBtn.closest('[data-section-divider]');
        if (!currentDivider) return;
        const allDividers = Array.from(document.querySelectorAll('.article-body [data-section-divider], .article-body h2, .article-body h3'));
        const currentIdx = allDividers.indexOf(currentDivider as HTMLElement);
        const nextTarget = allDividers[currentIdx + 1] as HTMLElement | undefined;

        if (nextTarget) {
          nextTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          const signature = document.querySelector('.article-signature') || document.querySelector('.article-related');
          signature?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        return;
      }

      // Handle Slideshow thumbnail click
      const thumbBtn = target.closest('.gallery-thumb-btn') as HTMLElement | null;
      if (thumbBtn) {
        const gallery = thumbBtn.closest('[data-gallery-slideshow]');
        if (!gallery) return;
        const mainImg = gallery.querySelector('.gallery-main-img') as HTMLImageElement | null;
        const mainCaption = gallery.querySelector('.gallery-main-caption');
        const counter = gallery.querySelector('.current-idx');
        const allThumbs = gallery.querySelectorAll('.gallery-thumb-btn');

        const src = thumbBtn.getAttribute('data-src') || '';
        const caption = thumbBtn.getAttribute('data-caption') || '';
        const index = parseInt(thumbBtn.getAttribute('data-index') || '0', 10);

        if (mainImg && src) {
          mainImg.src = src;
          mainImg.setAttribute('data-lightbox-src', src);
          mainImg.setAttribute('data-caption', caption);
        }
        if (mainCaption) mainCaption.textContent = caption;
        if (counter) counter.textContent = String(index + 1);

        allThumbs.forEach((t) => t.classList.remove('active'));
        thumbBtn.classList.add('active');
        return;
      }

      // Handle Slideshow prev/next navigation
      const navBtn = target.closest('.gallery-nav-btn') as HTMLElement | null;
      if (navBtn) {
        const gallery = navBtn.closest('[data-gallery-slideshow]');
        if (!gallery) return;
        const allThumbs = Array.from(gallery.querySelectorAll('.gallery-thumb-btn')) as HTMLElement[];
        if (allThumbs.length > 0) {
          let activeIdx = allThumbs.findIndex((t) => t.classList.contains('active'));
          if (activeIdx === -1) activeIdx = 0;
          const isNext = navBtn.classList.contains('next');
          let newIdx = isNext ? activeIdx + 1 : activeIdx - 1;
          if (newIdx < 0) newIdx = allThumbs.length - 1;
          if (newIdx >= allThumbs.length) newIdx = 0;

          const targetThumb = allThumbs[newIdx];
          if (targetThumb) {
            targetThumb.click();
          }
        }
        return;
      }

      // Handle Image Lightbox click
      if (target.tagName === 'IMG' && (target.closest('.article-body') || target.classList.contains('article-cover__img'))) {
        if (target.closest('.article-related') || target.classList.contains('gallery-thumb-btn')) return;
        const src = target.getAttribute('data-lightbox-src') || (target as HTMLImageElement).src;
        const caption = target.getAttribute('data-caption') || target.getAttribute('alt') || '';
        if (src && !src.includes('/images/logo.png')) {
          e.preventDefault();
          openLightbox(src, caption);
        }
      }
    });
  }
</script>

<style>
  .article-page--no-cover {
    padding-top: 100px;
  }

  .article-cover {
    position: relative;
    width: 100%;
    height: clamp(320px, 55vh, 600px);
    overflow: hidden;
  }

  .article-cover__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-cover__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, var(--color-bg) 100%);
  }

  .article-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-6);
    font-size: var(--fs-sm);
    color: var(--color-text-tertiary);
  }

  .article-breadcrumb__link {
    transition: color var(--dur-fast);
  }
  .article-breadcrumb__link:hover { color: var(--color-accent); }
  .article-breadcrumb__sep { opacity: 0.5; }

  .article-header {
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-10);
  }

  .article-header .eyebrow {
    margin-bottom: var(--space-4);
  }

  .article-header__title {
    font-family: var(--font-serif);
    font-size: var(--fs-3xl);
    font-weight: 700;
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-8);
  }

  .article-body {
    font-family: var(--font-sans);
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--color-text-primary);
    padding-bottom: var(--space-20);
  }

  .article-body :global(h2) {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }

  .article-body :global(h3) {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .article-body :global(p) {
    margin-bottom: var(--space-6);
  }

  .article-body :global(img) {
    border-radius: var(--radius-md);
    margin-block: var(--space-8);
  }

  .article-body :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-6);
    margin-block: var(--space-8);
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-secondary);
  }

  /* Rich Media Elements & Positioning */
  .article-body :global(.article-image) {
    margin-block: var(--space-8);
    text-align: center;
    clear: both;
    position: relative;
    width: 100%;
  }
  .article-body :global(.article-image img) {
    width: 100%;
    max-height: 620px;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin: 0 auto;
    display: block;
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }
  .article-body :global(.article-image img:hover) {
    transform: scale(1.015);
  }
  .article-body :global(.article-image figcaption) {
    font-size: var(--fs-xs);
    color: var(--color-text-tertiary);
    margin-top: var(--space-3);
    font-family: var(--font-sans);
    font-style: italic;
  }

  /* Image & Gallery Alignment & Sizing */
  .article-body :global(.align-center) { text-align: center; margin-inline: auto; clear: both; }
  .article-body :global(.align-left) {
    float: left;
    margin-right: var(--space-6);
    margin-bottom: var(--space-4);
    max-width: 48%;
  }
  .article-body :global(.align-right) {
    float: right;
    margin-left: var(--space-6);
    margin-bottom: var(--space-4);
    max-width: 48%;
  }
  @media (max-width: 640px) {
    .article-body :global(.align-left),
    .article-body :global(.align-right) {
      float: none !important;
      max-width: 100% !important;
      margin-inline: 0 !important;
    }
  }
  .article-body :global(.align-full-width),
  .article-body :global(.gallery-full-width) {
    width: 100vw !important;
    position: relative !important;
    left: 50% !important;
    right: 50% !important;
    margin-left: -50vw !important;
    margin-right: -50vw !important;
    max-width: 100vw !important;
    padding-inline: var(--gutter) !important;
    clear: both;
  }

  .article-body :global(.size-small img) { max-width: 340px !important; margin-inline: auto; }
  .article-body :global(.size-medium img) { max-width: 580px !important; margin-inline: auto; }

  .article-body :global(p::after) {
    content: "";
    display: table;
    clear: both;
  }

  /* ── Wix CMS Rich Content Gallery Presets ── */

  /* 1. Grid Preset */
  .article-body :global(.article-gallery-grid) {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-8);
    width: 100%;
    clear: both;
  }
  .article-body :global(.article-gallery-grid.cols-1) { grid-template-columns: 1fr; }
  .article-body :global(.article-gallery-grid.cols-2) { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .article-body :global(.article-gallery-grid.cols-3) { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }

  .article-body :global(.article-gallery-grid__item) {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-hover);
    margin: 0 !important;
    box-shadow: var(--shadow-sm);
  }
  .article-body :global(.article-gallery-grid__item img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    margin: 0 !important;
    cursor: pointer;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }
  .article-body :global(.article-gallery-grid__item:hover img) {
    transform: scale(1.03);
  }

  /* 2. Collage Preset */
  .article-body :global(.article-gallery-collage) {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-4);
    margin-block: var(--space-8);
    width: 100%;
    clear: both;
  }
  @media (max-width: 640px) {
    .article-body :global(.article-gallery-collage) {
      grid-template-columns: 1fr;
    }
  }
  .article-body :global(.article-gallery-collage__hero) {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin: 0 !important;
    background: var(--color-surface-hover);
    height: 100%;
  }
  .article-body :global(.article-gallery-collage__hero img) {
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
    display: block;
    margin: 0 !important;
    cursor: pointer;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }
  .article-body :global(.article-gallery-collage__hero:hover img) {
    transform: scale(1.03);
  }
  .article-body :global(.article-gallery-collage__grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: var(--space-3);
  }
  .article-body :global(.article-gallery-collage__item) {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin: 0 !important;
    background: var(--color-surface-hover);
  }
  .article-body :global(.article-gallery-collage__item img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    margin: 0 !important;
    cursor: pointer;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }
  .article-body :global(.article-gallery-collage__item:hover img) {
    transform: scale(1.03);
  }

  /* 3. Panorama Slideshow Preset */
  .article-body :global(.article-gallery-panorama) {
    margin-block: var(--space-8);
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #0d0d0c;
    box-shadow: var(--shadow-sm);
    clear: both;
  }
  .article-body :global(.gallery-panorama-stage) {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 9;
    min-height: 260px;
    max-height: 460px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .article-body :global(.gallery-panorama-stage img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0 !important;
    cursor: pointer;
  }

  /* 4. Slider Track Preset */
