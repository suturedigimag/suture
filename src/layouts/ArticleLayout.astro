---
/**
 * ArticleLayout.astro — Article-specific layout
 * Includes reading progress bar activation, author block, related articles strip.
 */
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import AuthorBlock from '../components/AuthorBlock.astro';
import ArticleGallery from '../components/ArticleGallery.astro';
import Footer from '../components/Footer.astro';
import type { Article } from '../lib/cms';
import { getArticleUrl, extractArticlePhotos } from '../lib/cms';

interface Props {
  article: Article;
  relatedArticles?: Article[];
  sectionName?: string;
  sectionHref?: string;
}

const { article, relatedArticles = [], sectionName, sectionHref } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(article._createdDate));

const photos = extractArticlePhotos(article);
const isBeyondBooks = sectionHref?.includes('/beyond-the-books') ?? false;
const hasRealCoverImage = Boolean(article.coverImage && !article.coverImage.includes('/images/logo.png'));
---

<Base
  title={article.title}
  description={`${article.title} — ${sectionName ?? 'The Suture'}`}
  ogImage={article.coverImage}
>
  <Nav />

  <main id="main-content">
    <article class={`article-page ${!hasRealCoverImage ? 'article-page--no-cover' : ''}`}>

      <!-- Hero cover (Hidden as fallback if no real cover photo is provided) -->
      {hasRealCoverImage && (
        <div class="article-cover">
          <img
            src={article.coverImage}
            alt={article.title}
            class="article-cover__img"
            loading="eager"
            decoding="async"
            onerror="this.parentElement.style.display='none'"
          />
          <div class="article-cover__gradient"></div>
        </div>
      )}

      <div class="container--narrow">

        <!-- Breadcrumb -->
        {sectionName && (
          <nav class="article-breadcrumb" aria-label="Breadcrumb">
            <a href="/suture" class="article-breadcrumb__link">The Suture</a>
            <span class="article-breadcrumb__sep" aria-hidden="true">·</span>
            {sectionHref && (
              <a href={sectionHref} class="article-breadcrumb__link">{sectionName}</a>
            )}
          </nav>
        )}

        <!-- Header -->
        <header class="article-header" data-reveal>
          <p class="eyebrow">{sectionName}</p>
          <h1 class="article-header__title">{article.title}</h1>

          <div class="article-header__meta">
            <AuthorBlock
              author={article.author}
              authorPhoto={article.authorPhoto}
              date={formattedDate}
            />
          </div>
        </header>

        <!-- Body -->
        <div class="article-body" data-reveal data-delay="200">
          <slot />
        </div>

        <!-- Interactive Article Photo Gallery -->
        <ArticleGallery photos={photos} isBeyondBooks={isBeyondBooks} />

        <!-- Author Signature Block -->
        {article.author && (
          <div class="article-signature" data-reveal>
            <div class="article-signature__header">
              {article.authorPhoto && (
                <img
                  src={article.authorPhoto}
                  alt={article.author}
                  class="article-signature__photo"
                  onerror="this.style.display='none'"
                />
              )}
              <div class="article-signature__meta">
                <span class="article-signature__label">Written By</span>
                <h3 class="article-signature__name">{article.author}</h3>
              </div>
            </div>
            {article.authorDescription && (
              <p class="article-signature__bio">{article.authorDescription}</p>
            )}
          </div>
        )}

      </div>

      <!-- Related articles -->
      {relatedArticles.length > 0 && (
        <section class="article-related section-py">
          <div class="container">
            <h2 class="article-related__heading" data-reveal>More from {sectionName}</h2>
            <div class="article-related__grid">
              {relatedArticles.slice(0, 3).map((rel, i) => (
                <a
                  href={getArticleUrl(rel)}
                  class="article-related__card"
                  data-reveal
                  data-delay={String(i * 100)}
                >
                  {rel.coverImage && (
                    <div class="article-related__img-wrap">
                      <img src={rel.coverImage} alt={rel.title} loading="lazy" decoding="async" />
                    </div>
                  )}
                  <h3 class="article-related__title">{rel.title}</h3>
                  {rel.author && <p class="article-related__author">{rel.author}</p>}
                </a>
              ))}
            </div>
          </div>
        </section>
      )}
    </article>
  </main>

  <Footer />
</Base>

<!-- Reading progress bar activation -->
<script>
  const bar = document.getElementById('reading-progress');
  if (bar) {
    const body = document.querySelector('.article-body') as HTMLElement;
    const update = () => {
      if (!body) return;
      const rect = body.getBoundingClientRect();
      const start = window.scrollY + rect.top;
      const end = start + body.offsetHeight - window.innerHeight;
      const pct = Math.min(100, Math.max(0, ((window.scrollY - start) / (end - start)) * 100));
      bar.style.width = pct + '%';
      bar.setAttribute('aria-valuenow', String(Math.round(pct)));
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .article-page--no-cover {
    padding-top: 100px;
  }

  .article-cover {
    position: relative;
    width: 100%;
    height: clamp(320px, 55vh, 600px);
    overflow: hidden;
  }

  .article-cover__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-cover__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, var(--color-bg) 100%);
  }

  .article-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-6);
    font-size: var(--fs-sm);
    color: var(--color-text-tertiary);
  }

  .article-breadcrumb__link {
    transition: color var(--dur-fast);
  }
  .article-breadcrumb__link:hover { color: var(--color-accent); }
  .article-breadcrumb__sep { opacity: 0.5; }

  .article-header {
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-10);
  }

  .article-header .eyebrow {
    margin-bottom: var(--space-4);
  }

  .article-header__title {
    font-family: var(--font-serif);
    font-size: var(--fs-3xl);
    font-weight: 700;
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-8);
  }

  .article-body {
    font-family: var(--font-sans);
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--color-text-primary);
    padding-bottom: var(--space-20);
  }

  .article-body :global(h2) {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }

  .article-body :global(h3) {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .article-body :global(p) {
    margin-bottom: var(--space-6);
  }

  .article-body :global(img) {
    border-radius: var(--radius-md);
    margin-block: var(--space-8);
  }

  .article-body :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-6);
    margin-block: var(--space-8);
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-secondary);
  }

  /* Rich Media Elements */
  .article-body :global(.article-image) {
    margin-block: var(--space-8);
    text-align: center;
  }
  .article-body :global(.article-image img) {
    width: 100%;
    max-height: 600px;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin: 0;
  }
  .article-body :global(.article-image figcaption) {
    font-size: var(--fs-xs);
    color: var(--color-text-tertiary);
    margin-top: var(--space-2);
    font-family: var(--font-sans);
  }

  .article-body :global(.article-gallery) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
    margin-block: var(--space-8);
  }
  .article-body :global(.article-gallery__item) {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface-hover);
  }
  .article-body :global(.article-gallery__item img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0 !important;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }
  .article-body :global(.article-gallery__item:hover img) {
    transform: scale(1.05);
  }

  /* Rich Content Divider */
  .article-body :global(.article-divider) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin-block: var(--space-10);
  }

  /* Rich Content Code blocks */
  .article-body :global(pre) {
    background: var(--color-surface-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    overflow-x: auto;
    margin-block: var(--space-6);
  }
  .article-body :global(code) {
    font-family: monospace;
    font-size: 0.9em;
  }

  /* Rich Content Tables */
  .article-body :global(.article-table-wrap) {
    width: 100%;
    overflow-x: auto;
    margin-block: var(--space-8);
  }
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  .article-body :global(th), .article-body :global(td) {
    border: 1px solid var(--color-border);
    padding: var(--space-3) var(--space-4);
    text-align: left;
  }
  .article-body :global(th) {
    background: var(--color-surface-hover);
    font-weight: 600;
  }

  /* Rich Content Videos */
  .article-body :global(.article-video) {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 ratio */
    height: 0;
    margin-block: var(--space-8);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #000;
  }
  .article-body :global(.article-video iframe),
  .article-body :global(.article-video video) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Related articles */
  .article-related {
    background: var(--color-surface-hover);
    border-top: 1px solid var(--color-border);
  }

  .article-related__heading {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    margin-bottom: var(--space-8);
  }

  .article-related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .article-related__card {
    display: block;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }
  .article-related__card:hover { transform: translateY(-4px); }

  .article-related__img-wrap {
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 3/2;
    margin-bottom: var(--space-4);
  }
  .article-related__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slower) var(--ease-out-expo);
  }
  .article-related__card:hover .article-related__img-wrap img {
    transform: scale(1.04);
  }

  .article-related__title {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    margin-bottom: var(--space-2);
    line-height: var(--lh-snug);
  }

  .article-related__author {
    font-size: var(--fs-sm);
    color: var(--color-text-tertiary);
  }

  /* Author Signature */
  .article-signature {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    margin-bottom: var(--space-16);
  }

  .article-signature__header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .article-signature__photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2.5px solid var(--color-border);
  }

  .article-signature__meta {
    display: flex;
    flex-direction: column;
  }

  .article-signature__label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-widest);
    color: var(--color-text-tertiary);
    margin-bottom: 2px;
  }

  .article-signature__name {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .article-signature__bio {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
    margin: 0;
  }
</style>
