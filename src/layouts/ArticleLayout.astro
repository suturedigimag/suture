---
/**
 * ArticleLayout.astro — Article-specific layout
 * Includes reading progress bar activation, author block, related articles strip.
 */
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import AuthorBlock from '../components/AuthorBlock.astro';
import Footer from '../components/Footer.astro';
import type { Article } from '../lib/cms';
import { getArticleUrl } from '../lib/cms';

interface Props {
  article: Article;
  relatedArticles?: Article[];
  sectionName?: string;
  sectionHref?: string;
}

const { article, relatedArticles = [], sectionName, sectionHref } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(article._createdDate));

const hasRealCoverImage = Boolean(article.coverImage && !article.coverImage.includes('/images/logo.png'));
---

<Base
  title={article.title}
  description={`${article.title} — ${sectionName ?? 'The Suture'}`}
  ogImage={article.coverImage}
>
  <Nav />

  <main id="main-content">
    <article class={`article-page ${!hasRealCoverImage ? 'article-page--no-cover' : ''}`}>

      <!-- Hero cover (Hidden as fallback if no real cover photo is provided) -->
      {hasRealCoverImage && (
        <div class="article-cover">
          <img
            src={article.coverImage}
            alt={article.title}
            class="article-cover__img"
            loading="eager"
            decoding="async"
            onerror="this.parentElement.style.display='none'"
          />
          <div class="article-cover__gradient"></div>
        </div>
      )}

      <div class="container--narrow">

        <!-- Breadcrumb -->
        {sectionName && (
          <nav class="article-breadcrumb" aria-label="Breadcrumb">
            <a href="/suture" class="article-breadcrumb__link">The Suture</a>
            <span class="article-breadcrumb__sep" aria-hidden="true">·</span>
            {sectionHref && (
              <a href={sectionHref} class="article-breadcrumb__link">{sectionName}</a>
            )}
          </nav>
        )}

        <!-- Header -->
        <header class="article-header" data-reveal>
          <p class="eyebrow">{sectionName}</p>
          <h1 class="article-header__title">{article.title}</h1>

          <div class="article-header__meta">
            <AuthorBlock
              author={article.author}
              authorPhoto={article.authorPhoto}
              date={formattedDate}
            />
          </div>
        </header>

        <!-- Article Body Content -->
        <div class="article-body" data-reveal data-delay="200">
          <slot />
        </div>

        <!-- Author Signature Block -->
        {article.author && (
          <div class="article-signature" data-reveal>
            <div class="article-signature__header">
              {article.authorPhoto && (
                <img
                  src={article.authorPhoto}
                  alt={article.author}
                  class="article-signature__photo"
                  onerror="this.style.display='none'"
                />
              )}
              <div class="article-signature__meta">
                <span class="article-signature__label">Written By</span>
                <h3 class="article-signature__name">{article.author}</h3>
              </div>
            </div>
            {article.authorDescription && (
              <p class="article-signature__bio">{article.authorDescription}</p>
            )}
          </div>
        )}

      </div>

      <!-- Related articles -->
      {relatedArticles.length > 0 && (
        <section class="article-related section-py">
          <div class="container">
            <h2 class="article-related__heading" data-reveal>More from {sectionName}</h2>
            <div class="article-related__grid">
              {relatedArticles.slice(0, 3).map((rel, i) => (
                <a
                  href={getArticleUrl(rel)}
                  class="article-related__card"
                  data-reveal
                  data-delay={String(i * 100)}
                >
                  {rel.coverImage && (
                    <div class="article-related__img-wrap">
                      <img src={rel.coverImage} alt={rel.title} loading="lazy" decoding="async" />
                    </div>
                  )}
                  <h3 class="article-related__title">{rel.title}</h3>
                  {rel.author && <p class="article-related__author">{rel.author}</p>}
                </a>
              ))}
            </div>
          </div>
        </section>
      )}
    </article>
  </main>

  <!-- Unified Full-Screen Lightbox Modal -->
  <div class="image-lightbox" id="image-lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close Lightbox">&times;</button>
    <div class="lightbox-content">
      <img src="" alt="" id="lightbox-img" />
      <p id="lightbox-caption" class="lightbox-caption"></p>
    </div>
  </div>

  <Footer />
</Base>

<!-- Reading progress bar & Unified Photo Lightbox handler -->
<script>
  // Reading progress bar activation
  const bar = document.getElementById('reading-progress');
  if (bar) {
    const body = document.querySelector('.article-body') as HTMLElement;
    const update = () => {
      if (!body) return;
      const rect = body.getBoundingClientRect();
      const start = window.scrollY + rect.top;
      const end = start + body.offsetHeight - window.innerHeight;
      const pct = Math.min(100, Math.max(0, ((window.scrollY - start) / (end - start)) * 100));
      bar.style.width = pct + '%';
      bar.setAttribute('aria-valuenow', String(Math.round(pct)));
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  // Single Unified Lightbox modal for all article photos & galleries
  const lightbox = document.getElementById('image-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxClose = document.getElementById('lightbox-close');

  if (lightbox && lightboxImg) {
    const openLightbox = (src: string, caption?: string) => {
      lightboxImg.src = src;
      lightboxImg.alt = caption || 'Article photo';
      if (lightboxCaption) lightboxCaption.textContent = caption || '';
      lightbox.classList.add('image-lightbox--open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      lightbox.classList.remove('image-lightbox--open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      lightboxImg.src = '';
    };

    lightboxClose?.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || (e.target as HTMLElement).classList.contains('lightbox-close')) {
        closeLightbox();
      }
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target) return;

      // Handle Slideshow thumbnail click
      const thumbBtn = target.closest('.gallery-thumb-btn') as HTMLElement | null;
      if (thumbBtn) {
        const gallery = thumbBtn.closest('[data-gallery-slideshow]');
        if (!gallery) return;
        const mainImg = gallery.querySelector('.gallery-main-img') as HTMLImageElement | null;
        const mainCaption = gallery.querySelector('.gallery-main-caption');
        const counter = gallery.querySelector('.current-idx');
        const allThumbs = gallery.querySelectorAll('.gallery-thumb-btn');

        const src = thumbBtn.getAttribute('data-src') || '';
        const caption = thumbBtn.getAttribute('data-caption') || '';
        const index = parseInt(thumbBtn.getAttribute('data-index') || '0', 10);

        if (mainImg && src) {
          mainImg.src = src;
          mainImg.setAttribute('data-lightbox-src', src);
          mainImg.setAttribute('data-caption', caption);
        }
        if (mainCaption) mainCaption.textContent = caption;
        if (counter) counter.textContent = String(index + 1);

        allThumbs.forEach((t) => t.classList.remove('active'));
        thumbBtn.classList.add('active');
        return;
      }

      // Handle Slideshow prev/next navigation
      const navBtn = target.closest('.gallery-nav-btn') as HTMLElement | null;
      if (navBtn) {
        const gallery = navBtn.closest('[data-gallery-slideshow]');
        if (!gallery) return;
        const allThumbs = Array.from(gallery.querySelectorAll('.gallery-thumb-btn')) as HTMLElement[];
        if (!allThumbs.length) return;
        const activeIdx = allThumbs.findIndex((t) => t.classList.contains('active'));
        const isNext = navBtn.classList.contains('next');
        let newIdx = isNext ? activeIdx + 1 : activeIdx - 1;
        if (newIdx < 0) newIdx = allThumbs.length - 1;
        if (newIdx >= allThumbs.length) newIdx = 0;

        allThumbs[newIdx]?.click();
        return;
      }

      // Handle Image Lightbox click
      if (target.tagName === 'IMG' && (target.closest('.article-body') || target.classList.contains('article-cover__img'))) {
        if (target.closest('.article-related') || target.classList.contains('gallery-thumb-btn')) return;
        const src = target.getAttribute('data-lightbox-src') || (target as HTMLImageElement).src;
        const caption = target.getAttribute('data-caption') || target.getAttribute('alt') || '';
        if (src && !src.includes('/images/logo.png')) {
          e.preventDefault();
          openLightbox(src, caption);
        }
      }
    });
  }
</script>

<style>
  .article-page--no-cover {
    padding-top: 100px;
  }

  .article-cover {
    position: relative;
    width: 100%;
    height: clamp(320px, 55vh, 600px);
    overflow: hidden;
  }

  .article-cover__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-cover__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, var(--color-bg) 100%);
  }

  .article-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-6);
    font-size: var(--fs-sm);
    color: var(--color-text-tertiary);
  }

  .article-breadcrumb__link {
    transition: color var(--dur-fast);
  }
  .article-breadcrumb__link:hover { color: var(--color-accent); }
  .article-breadcrumb__sep { opacity: 0.5; }

  .article-header {
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-10);
  }

  .article-header .eyebrow {
    margin-bottom: var(--space-4);
  }

  .article-header__title {
    font-family: var(--font-serif);
    font-size: var(--fs-3xl);
    font-weight: 700;
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-8);
  }

  .article-body {
    font-family: var(--font-sans);
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--color-text-primary);
    padding-bottom: var(--space-20);
  }

  .article-body :global(h2) {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }

  .article-body :global(h3) {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .article-body :global(p) {
    margin-bottom: var(--space-6);
  }

  .article-body :global(img) {
    border-radius: var(--radius-md);
    margin-block: var(--space-8);
  }

  .article-body :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-6);
    margin-block: var(--space-8);
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-secondary);
  }

  /* Rich Media Elements */
  .article-body :global(.article-image) {
    margin-block: var(--space-8);
    text-align: center;
  }
  .article-body :global(.article-image img) {
    width: 100%;
    max-height: 600px;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin: 0;
  }
  .article-body :global(.article-image figcaption) {
    font-size: var(--fs-xs);
    color: var(--color-text-tertiary);
    margin-top: var(--space-2);
    font-family: var(--font-sans);
  }

  /* Image & Gallery Custom Alignment & Sizing */
  .article-body :global(.align-center) { text-align: center; margin-inline: auto; }
  .article-body :global(.align-left) { text-align: left; float: left; margin-right: var(--space-6); max-width: 50%; }
  .article-body :global(.align-right) { text-align: right; float: right; margin-left: var(--space-6); max-width: 50%; }
  .article-body :global(.align-full-width),
  .article-body :global(.gallery-full-width) {
    width: 100vw !important;
    position: relative !important;
    left: 50% !important;
    right: 50% !important;
    margin-left: -50vw !important;
    margin-right: -50vw !important;
    max-width: 100vw !important;
    padding-inline: var(--gutter) !important;
  }

  .article-body :global(.size-small img) { max-width: 340px !important; margin-inline: auto; }
  .article-body :global(.size-medium img) { max-width: 580px !important; margin-inline: auto; }

  /* ── Wix CMS Rich Content Gallery Presets ── */

  /* 1. Grid Preset */
  .article-body :global(.article-gallery-grid) {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-8);
    width: 100%;
  }
  .article-body :global(.article-gallery-grid.cols-1) { grid-template-columns: 1fr; }
  .article-body :global(.article-gallery-grid.cols-2) { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .article-body :global(.article-gallery-grid.cols-3) { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }

  .article-body :global(.article-gallery-grid__item) {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-hover);
    margin: 0 !important;
    box-shadow: var(--shadow-sm);
  }
  .article-body :global(.article-gallery-grid__item img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    margin: 0 !important;
    cursor: pointer;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }
  .article-body :global(.article-gallery-grid__item:hover img) {
    transform: scale(1.03);
  }

  /* 2. Fullsize / Slideshow / Thumbnail Preset */
  .article-body :global(.article-gallery-fullsize) {
    margin-block: var(--space-8);
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .article-body :global(.gallery-main-stage) {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 580px;
    background: #0d0d0c;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .article-body :global(.gallery-main-img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    margin: 0 !important;
    cursor: pointer;
  }
  .article-body :global(.gallery-main-caption) {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: var(--space-3) var(--space-5);
    background: linear-gradient(to top, rgba(0,0,0,0.85), transparent);
    color: #ffffff;
    font-size: var(--fs-xs);
    font-family: var(--font-sans);
  }
  .article-body :global(.gallery-nav-btn) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    color: #ffffff;
    border: 1px solid rgba(255,255,255,0.3);
    font-size: 1.8rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background var(--dur-fast);
  }
  .article-body :global(.gallery-nav-btn:hover) { background: rgba(0, 0, 0, 0.9); }
  .article-body :global(.gallery-nav-btn.prev) { left: var(--space-4); }
  .article-body :global(.gallery-nav-btn.next) { right: var(--space-4); }

  .article-body :global(.gallery-counter) {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: rgba(0, 0, 0, 0.65);
    color: #ffffff;
    font-size: var(--fs-xs);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    border: 1px solid rgba(255,255,255,0.2);
  }

  .article-body :global(.gallery-thumbs-track) {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3);
    overflow-x: auto;
    background: var(--color-surface-hover);
    border-top: 1px solid var(--color-border);
  }
  .article-body :global(.gallery-thumb-btn) {
    width: 72px;
    height: 52px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    background: transparent;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity var(--dur-fast), border-color var(--dur-fast);
  }
  .article-body :global(.gallery-thumb-btn.active),
  .article-body :global(.gallery-thumb-btn:hover) {
    opacity: 1;
    border-color: var(--color-brand);
  }
  .article-body :global(.gallery-thumb-btn img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0 !important;
  }

  /* 3. Masonry Preset */
  .article-body :global(.article-gallery-masonry) {
    column-count: 3;
    column-gap: var(--space-4);
    margin-block: var(--space-8);
  }
  @media (max-width: 768px) {
    .article-body :global(.article-gallery-masonry) { column-count: 2; }
  }
  .article-body :global(.article-gallery-masonry__item) {
    break-inside: avoid;
    margin-bottom: var(--space-4) !important;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-hover);
    box-shadow: var(--shadow-sm);
  }
  .article-body :global(.article-gallery-masonry__item img) {
    width: 100%;
    height: auto;
    display: block;
    margin: 0 !important;
    cursor: pointer;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }
  .article-body :global(.article-gallery-masonry__item:hover img) {
    transform: scale(1.03);
  }

  .article-body :global(.article-gallery-caption) {
    font-size: var(--fs-xs);
    color: var(--color-text-tertiary);
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    font-family: var(--font-sans);
    margin: 0;
  }

  /* Rich Content Divider */
  .article-body :global(.article-divider) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin-block: var(--space-10);
  }

  /* Rich Content Code blocks */
  .article-body :global(pre) {
    background: var(--color-surface-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    overflow-x: auto;
    margin-block: var(--space-6);
  }
  .article-body :global(code) {
    font-family: monospace;
    font-size: 0.9em;
  }

  /* Rich Content Tables */
  .article-body :global(.article-table-wrap) {
    width: 100%;
    overflow-x: auto;
    margin-block: var(--space-8);
  }
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  .article-body :global(th), .article-body :global(td) {
    border: 1px solid var(--color-border);
    padding: var(--space-3) var(--space-4);
    text-align: left;
  }
  .article-body :global(th) {
    background: var(--color-surface-hover);
    font-weight: 600;
  }

  /* Rich Content Videos */
  .article-body :global(.article-video) {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 ratio */
    height: 0;
    margin-block: var(--space-8);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #000;
  }
  .article-body :global(.article-video iframe),
  .article-body :global(.article-video video) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Related articles */
  .article-related {
    background: var(--color-surface-hover);
    border-top: 1px solid var(--color-border);
  }

  .article-related__heading {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    margin-bottom: var(--space-8);
  }

  .article-related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .article-related__card {
    display: block;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }
  .article-related__card:hover { transform: translateY(-4px); }

  .article-related__img-wrap {
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 3/2;
    margin-bottom: var(--space-4);
  }
  .article-related__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slower) var(--ease-out-expo);
  }
  .article-related__card:hover .article-related__img-wrap img {
    transform: scale(1.04);
  }

  .article-related__title {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    margin-bottom: var(--space-2);
    line-height: var(--lh-snug);
  }

  .article-related__author {
    font-size: var(--fs-sm);
    color: var(--color-text-tertiary);
  }

  /* Author Signature */
  .article-signature {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    margin-bottom: var(--space-16);
  }

  .article-signature__header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .article-signature__photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2.5px solid var(--color-border);
  }

  .article-signature__meta {
    display: flex;
    flex-direction: column;
  }

  .article-signature__label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-widest);
    color: var(--color-text-tertiary);
    margin-bottom: 2px;
  }

  .article-signature__name {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .article-signature__bio {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
    margin: 0;
  }

  /* Full screen Lightbox Modal */
  .image-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(10, 10, 8, 0.92);
    backdrop-filter: blur(16px);
