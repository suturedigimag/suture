---
/**
 * SearchAndFilters.astro — Modular live search & filter bar
 * Matches Vercel / Linear design systems: sleek search input + tag pills.
 *
 * Props:
 *   - categories?: Array<{ name: string; id: string }>
 *   - placeholder?: string
 */

interface Props {
  categories?: Array<{ name: string; id: string }>;
  placeholder?: string;
}

const { categories = [], placeholder = "Search articles by title or author..." } = Astro.props;
---

<div class="search-filter-bar" data-reveal>
  <div class="search-filter-bar__container">
    
    <!-- Search Input -->
    <div class="search-input-wrap">
      <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="search"
        class="search-input"
        placeholder={placeholder}
        aria-label="Search articles"
        id="search-input-el"
      />
    </div>

    <!-- Category Filter Pills (rendered only if categories exist) -->
    {categories.length > 0 && (
      <div class="filter-pills-wrap" role="group" aria-label="Filter by category">
        <button class="filter-pill filter-pill--active" data-category-id="all">
          All
        </button>
        {categories.map((c) => (
          <button class="filter-pill" data-category-id={c.id}>
            {c.name}
          </button>
        ))}
      </div>
    )}

  </div>
</div>

<script>
  const setupFilters = () => {
    const input = document.getElementById('search-input-el') as HTMLInputElement | null;
    const pills = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.editorial-card') as NodeListOf<HTMLElement>;

    if (!input && pills.length === 0) return;

    let activeCategory = 'all';
    let searchQuery = '';

    const filterCards = () => {
      let visibleCount = 0;
      cards.forEach((card) => {
        const title = card.getAttribute('data-search-title') || '';
        const author = card.getAttribute('data-search-author') || '';
        const category = card.getAttribute('data-category') || '';

        const matchesSearch = title.includes(searchQuery) || author.includes(searchQuery);
        const matchesCategory = activeCategory === 'all' || category === activeCategory;

        if (matchesSearch && matchesCategory) {
          card.style.display = '';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Handle empty state if needed
      const emptyState = document.getElementById('filter-empty-state');
      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    };

    // Listen to search typing
    input?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterCards();
    });

    // Listen to category pill clicks
    pills.forEach((pill) => {
      pill.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        
        // Toggle active classes
        pills.forEach((p) => p.classList.remove('filter-pill--active'));
        target.classList.add('filter-pill--active');

        activeCategory = target.getAttribute('data-category-id') || 'all';
        filterCards();
      });
    });
  };

  // Run on load and after Astro transitions
  setupFilters();
  document.addEventListener('astro:after-swap', setupFilters);
</script>

<style>
  .search-filter-bar {
    margin-bottom: var(--space-8);
  }

  .search-filter-bar__container {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* ── Search Input ───────────────────────────────────────────── */
  .search-input-wrap {
    position: relative;
    width: 100%;
    max-width: 500px;
  }

  .search-icon {
    position: absolute;
    left: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-tertiary);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    font-family: var(--font-sans);
    font-size: var(--fs-base);
    padding: var(--space-3) var(--space-4) var(--space-3) calc(var(--space-4) + 24px);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-primary);
    transition:
      border-color var(--dur-fast),
      box-shadow var(--dur-fast);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-muted);
  }

  /* ── Category Pills ─────────────────────────────────────────── */
  .filter-pills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .filter-pill {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--ls-wider);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: 20px;
    background: var(--color-surface);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      background var(--dur-fast),
      color var(--dur-fast),
      border-color var(--dur-fast);
  }

  .filter-pill:hover {
    background: var(--color-surface-hover);
    color: var(--color-text-primary);
  }

  .filter-pill--active {
    background: var(--color-accent);
    color: #FAFAF8;
    border-color: var(--color-accent);
  }

  .filter-pill--active:hover {
    background: var(--color-accent-hover);
    color: #FAFAF8;
  }
</style>
