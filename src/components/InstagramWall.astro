---
/**
 * InstagramWall.astro — Custom Instagram-powered Dome Gallery for @litclubpsgimsr
 * High-performance 3D Spherical Visualization of Literature Club Instagram posts
 * Premium Editorial Modal on post select (no Meta/Behold embeds or iframes).
 */
import DomeGallery from './react/DomeGallery';
import { INSTAGRAM_POSTS, OFFICIAL_IG_PROFILE } from '../data/instagramPosts';
---

<section class="ig-wall section-py" aria-label="Instagram 3D Dome Gallery">
  <div class="container">

    <div class="ig-wall__header" data-reveal>
      <p class="eyebrow">Follow along</p>
      <h2 class="ig-wall__title">
        <a href={OFFICIAL_IG_PROFILE} target="_blank" rel="noopener noreferrer">@litclubpsgimsr</a>
      </h2>
    </div>

    <!-- 3D Interactive Spherical Dome Gallery -->
    <div class="ig-wall__dome-container" data-reveal data-delay="100">
      <DomeGallery
        images={INSTAGRAM_POSTS}
        overlayBlurColor="#FAFAF8"
        fit={0.95}
        minRadius={950}
        maxRadius={1800}
        segments={45}
        openedImageWidth="460px"
        openedImageHeight="460px"
        client:only="react"
      />
    </div>

  </div>
</section>

<style>
  .ig-wall {
    position: relative;
    overflow: hidden;
  }

  .ig-wall__header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .ig-wall__title {
    font-family: var(--font-serif);
    font-size: var(--fs-2xl);
    font-weight: 400;
    color: var(--color-text-primary);
    margin-top: var(--space-2);
  }

  .ig-wall__title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out-expo);
  }

  .ig-wall__title a:hover {
    color: var(--color-brand);
  }

  .ig-wall__dome-container {
    width: 100%;
  }
</style>
