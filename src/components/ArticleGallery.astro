---
/**
 * ArticleGallery.astro — Dynamic photo display component for articles
 *
 * Rules:
 *   - 0 photos: Hides photo section completely (Fallback)
 *   - 1 to 3 photos (<= 3): Standard responsive grid listing
 *   - 4 to 10 photos (4 - 10): React Bits <Masonry /> component
 *   - > 10 photos: React Bits <CircularGallery /> component (WebGL, no wiggle)
 *   - Beyond The Books section: Always uses clean standard listing layout
 */
import type { ArticlePhoto } from '../lib/cms';
import Masonry from './react/Masonry.jsx';
import CircularGallery from './react/CircularGallery.jsx';

interface Props {
  photos: ArticlePhoto[];
  isBeyondBooks?: boolean;
}

const { photos = [], isBeyondBooks = false } = Astro.props;
const photoCount = photos.length;

// Map photos for Masonry component: { id, img, url, height }
const masonryItems = photos.map((p, idx) => ({
  id: p.id || `photo-${idx}`,
  img: p.img,
  url: p.url || '#',
  height: p.height || 400,
}));

// Map photos for CircularGallery component: { image, text }
const circularItems = photos.map((p, idx) => ({
  image: p.img,
  text: p.caption || p.text || `Photo ${idx + 1}`,
}));
---

{photoCount > 0 && (
  <section class="article-gallery-container" aria-label="Article photo gallery">
    <div class="gallery-header">
      <div>
        <span class="eyebrow">Gallery</span>
        <h3 class="gallery-title">{photoCount} {photoCount === 1 ? 'Photograph' : 'Photographs'}</h3>
      </div>
      <button type="button" class="gallery-action-btn" id="open-circular-gallery">
        <span>View 3D Gallery</span>
      </button>
    </div>

    <!-- Mode 1: Beyond The Books OR <= 3 photos: Standard Grid -->
    {(isBeyondBooks || photoCount <= 3) && (
      <div class={`standard-grid grid-cols-${Math.min(photoCount, 3)}`}>
        {photos.map((p) => (
          <div class="grid-item">
            <img src={p.img} alt={p.caption || 'Article photo'} loading="lazy" decoding="async" />
            {p.caption && <span class="grid-caption">{p.caption}</span>}
          </div>
        ))}
      </div>
    )}

    <!-- Mode 2: 4 to 10 photos: React Bits Masonry -->
    {!isBeyondBooks && photoCount >= 4 && photoCount <= 10 && (
      <div class="masonry-wrapper">
        <Masonry
          items={masonryItems}
          ease="power3.out"
          duration={0.6}
          stagger={0.05}
          animateFrom="bottom"
          scaleOnHover={true}
          hoverScale={0.97}
          blurToFocus={true}
          colorShiftOnHover={false}
          client:only="react"
        />
      </div>
    )}

    <!-- Mode 3: > 10 photos: React Bits CircularGallery inline -->
    {!isBeyondBooks && photoCount > 10 && (
      <div class="circular-wrapper">
        <CircularGallery
          items={circularItems}
          bend={2.5}
          textColor="#1A1A18"
          borderRadius={0.04}
          scrollSpeed={2}
          scrollEase={0.05}
          client:only="react"
        />
      </div>
    )}

    <!-- Full-Screen Interactive 3D Circular Gallery Modal -->
    <div class="circular-modal-overlay" id="circular-modal" role="dialog" aria-modal="true" aria-hidden="true">
      <button type="button" class="circular-modal-close" id="circular-modal-close" aria-label="Close 3D Gallery">&times;</button>
      <div class="circular-modal-body">
        <CircularGallery
          items={circularItems}
          bend={2.5}
          textColor="transparent"
          borderRadius={0.04}
          scrollSpeed={2}
          scrollEase={0.05}
          client:only="react"
        />
      </div>
    </div>
  </section>
)}

<script>
  function initCircularModal() {
    const modal = document.getElementById('circular-modal');
    const closeBtn = document.getElementById('circular-modal-close');

    if (!modal) return;

    // Teleport modal directly to document.body so it escapes all parent transform/container boundaries
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    const openModal = () => {
      modal.classList.add('circular-modal-overlay--open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // Trigger resize for OGL WebGL canvas calculation inside modal
      setTimeout(() => {
        window.dispatchEvent(new Event('resize'));
      }, 60);
    };

    const closeModal = () => {
      modal.classList.remove('circular-modal-overlay--open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    closeBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      closeModal();
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal || (e.target as HTMLElement).classList.contains('circular-modal-close')) {
        closeModal();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    // Listen to custom photo click events from Masonry component
    window.addEventListener('open-photo-modal', () => {
      openModal();
    });

    // Attach click handler to photos and 3D gallery button
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target) return;

      const trigger = target.closest('#open-circular-gallery') || target.closest('.item-wrapper') || target.closest('.grid-item');
      if (trigger) {
        e.preventDefault();
        openModal();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCircularModal);
  } else {
    initCircularModal();
  }
</script>

<style>
  .article-gallery-container {
    margin-block: var(--space-10);
    width: 100%;
  }

  .gallery-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .gallery-title {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 2px;
  }

  .gallery-action-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-brand);
    background: transparent;
    border: 1px solid var(--color-border);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out-expo);
  }

  .gallery-action-btn:hover {
    background: var(--color-brand);
    color: #ffffff;
    border-color: var(--color-brand);
  }

  /* Standard Grid Styling (<= 3 photos or Beyond The Books) */
  .standard-grid {
    display: grid;
    gap: var(--space-4);
    width: 100%;
  }

  .grid-cols-1 { grid-template-columns: 1fr; }
  .grid-cols-2 { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .grid-cols-3 { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }

  .grid-item {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-hover);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
  }

  .grid-item img {
    width: 100%;
    height: 100%;
    max-height: 500px;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }

  .grid-item:hover img {
    transform: scale(1.03);
  }

  .grid-caption {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    color: var(--color-text-secondary);
    background: var(--color-surface);
  }

  .masonry-wrapper,
  .circular-wrapper {
    width: 100%;
    position: relative;
  }

  /* Teleported Full-Screen Circular Gallery Modal Overlay */
  :global(.circular-modal-overlay) {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    z-index: 9999999 !important;
    background: rgba(10, 10, 8, 0.92) !important;
    backdrop-filter: blur(24px) !important;
    -webkit-backdrop-filter: blur(24px) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transition: opacity 0.3s ease, visibility 0.3s ease !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  :global(.circular-modal-overlay--open) {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  :global(.circular-modal-close) {
    position: absolute !important;
    top: 24px !important;
    right: 24px !important;
    background: rgba(255, 255, 255, 0.18) !important;
    color: #ffffff !important;
    font-size: 2.2rem !important;
    line-height: 1 !important;
    width: 52px !important;
    height: 52px !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    z-index: 10000000 !important;
    transition: background 0.2s ease !important;
  }

  :global(.circular-modal-close:hover) {
    background: rgba(255, 255, 255, 0.4) !important;
  }

  :global(.circular-modal-body) {
    width: 100vw !important;
    height: 100vh !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    position: relative !important;
    overflow: hidden !important;
  }

  :global(.circular-modal-body .circular-gallery) {
    width: 100vw !important;
    height: 100vh !important;
    margin: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
  }
</style>
