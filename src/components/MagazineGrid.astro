---
/**
 * MagazineGrid.astro — Asymmetric editorial grid
 * Shows a large hero article + 2 secondary + 2 compact sidebar.
 * Used on section landings and as an enhanced homepage block.
 */
import { Image } from 'astro:assets';
import { getArticleUrl, type Article } from '../lib/cms';

interface Props {
  articles: Article[];
  sectionLabel?: string;
}

const { articles, sectionLabel } = Astro.props;

if (articles.length < 1) return;

const [hero, second, third, ...rest] = articles;

const fmt = (d: string) =>
  new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(d));
---

<div class="mag-grid" data-reveal>

  <!-- Left: big hero card -->
  {hero && (
    <a href={getArticleUrl(hero)} class="mag-grid__hero">
      {hero.coverImage ? (
        <div class="mag-grid__hero-img-wrap">
          <Image src={hero.coverImage} alt={hero.title} width={900} height={675} loading="lazy" decoding="async" class="mag-grid__hero-img" />
          <div class="mag-grid__hero-gradient"></div>
        </div>
      ) : (
        <div class="mag-grid__hero-placeholder"></div>
      )}
      <div class="mag-grid__hero-content">
        {sectionLabel && <p class="eyebrow">{sectionLabel}</p>}
        <h3 class="mag-grid__hero-title">{hero.title}</h3>
        {hero.author && (
          <p class="mag-grid__meta">{hero.author} · <time datetime={hero._createdDate}>{fmt(hero._createdDate)}</time></p>
        )}
      </div>
    </a>
  )}

  <!-- Right: stacked secondary + sidebar -->
  <div class="mag-grid__right">

    <!-- Two secondary cards stacked -->
    <div class="mag-grid__secondary-col">
      {[second, third].filter(Boolean).map((article) => (
        article && (
          <a href={getArticleUrl(article)} class="mag-grid__secondary">
            {article.coverImage && (
              <div class="mag-grid__secondary-img-wrap">
                <Image src={article.coverImage} alt={article.title} width={160} height={160} loading="lazy" decoding="async" />
              </div>
            )}
            <div class="mag-grid__secondary-body">
              <h4 class="mag-grid__secondary-title">{article.title}</h4>
              {article.author && <p class="mag-grid__meta">{article.author} · <time datetime={article._createdDate}>{fmt(article._createdDate)}</time></p>}
            </div>
          </a>
        )
      ))}
    </div>

    <!-- Compact sidebar list -->
    {rest.length > 0 && (
      <div class="mag-grid__sidebar">
        <p class="mag-grid__sidebar-label">Also in this section</p>
        <ul>
          {rest.slice(0, 4).map((article) => (
            <li>
              <a href={getArticleUrl(article)} class="mag-grid__sidebar-item">
                <span class="mag-grid__sidebar-title">{article.title}</span>
                {article.author && <span class="mag-grid__meta">{article.author}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

  </div>
</div>

<style>
  .mag-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-6);
    align-items: start;
  }

  /* ── Hero card ──────────────────────────────────────────────── */
  .mag-grid__hero {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    aspect-ratio: 4/3;
    transition: box-shadow var(--dur-normal) var(--ease-out-expo);
  }
  .mag-grid__hero:hover { box-shadow: var(--shadow-card-hover); }

  .mag-grid__hero-img-wrap {
    position: absolute;
    inset: 0;
  }
  .mag-grid__hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slower) var(--ease-out-expo);
  }
  .mag-grid__hero:hover .mag-grid__hero-img { transform: scale(1.04); }

  .mag-grid__hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,10,8,0.85) 0%, rgba(10,10,8,0.3) 50%, transparent 100%);
  }

  .mag-grid__hero-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-border), var(--color-surface-hover));
  }

  .mag-grid__hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-6);
  }

  .mag-grid__hero-content .eyebrow { color: var(--color-accent); margin-bottom: var(--space-2); }

  .mag-grid__hero-title {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    font-weight: 700;
    line-height: var(--lh-snug);
    color: #FAFAF8;
    margin-bottom: var(--space-2);
  }

  /* ── Right column ───────────────────────────────────────────── */
  .mag-grid__right {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mag-grid__secondary-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mag-grid__secondary {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: box-shadow var(--dur-normal), transform var(--dur-normal) var(--ease-out-expo);
  }
  .mag-grid__secondary:hover {
    box-shadow: var(--shadow-md);
    transform: translateX(4px);
  }

  .mag-grid__secondary-img-wrap {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .mag-grid__secondary-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slower);
  }
  .mag-grid__secondary:hover .mag-grid__secondary-img-wrap img { transform: scale(1.06); }

  .mag-grid__secondary-body { flex: 1; }

  .mag-grid__secondary-title {
    font-family: var(--font-serif);
    font-size: var(--fs-base);
    font-weight: 700;
    line-height: var(--lh-snug);
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
  }

  /* ── Sidebar list ───────────────────────────────────────────── */
  .mag-grid__sidebar {
    background: var(--color-surface-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .mag-grid__sidebar-label {
    font-size: var(--fs-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--ls-widest);
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-4);
  }

  .mag-grid__sidebar ul {
    display: flex;
    flex-direction: column;
  }

  .mag-grid__sidebar-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    transition: padding-left var(--dur-fast);
  }
  .mag-grid__sidebar ul li:last-child .mag-grid__sidebar-item { border-bottom: none; }
  .mag-grid__sidebar-item:hover { padding-left: var(--space-2); }

  .mag-grid__sidebar-title {
    font-family: var(--font-serif);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: var(--lh-snug);
  }

  /* ── Shared meta ────────────────────────────────────────────── */
  .mag-grid__meta {
    font-size: var(--fs-xs);
    color: var(--color-text-tertiary);
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .mag-grid {
      grid-template-columns: 1fr;
    }
    .mag-grid__hero { aspect-ratio: 16/9; }
  }
</style>
