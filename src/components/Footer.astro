---
/**
 * Footer.astro — The Suture site footer
 */
---

<footer class="footer" role="contentinfo">
  <div class="container">

    <div class="footer__top">
      <!-- Logotype -->
      <div class="footer__brand">
        <a href="/suture" class="footer__logo-link" aria-label="The Suture — Home">
          <img src="/images/logo.png" alt="The Suture Logo" class="footer__logo-img" />
        </a>
        <p class="footer__tagline">The independent editorial publication of Literature Club.</p>
        <p style="font-size: var(--fs-xs); color: var(--color-text-tertiary); margin-top: var(--space-4);">
          Contact: <a href="mailto:suturedigimag@psgimsr.ac.in" style="color: var(--color-accent); text-decoration: underline;">suturedigimag@psgimsr.ac.in</a>
        </p>
      </div>

      <!-- Navigation columns -->
      <nav class="footer__nav" aria-label="Footer navigation">

        <div class="footer__col">
          <p class="footer__col-label">Sections</p>
          <ul role="list">
            <li><a href="/suture/sections/clinical-case-corner" class="footer__link">Clinical Case Corner</a></li>
            <li><a href="/suture/sections/decrypt-and-diagnose" class="footer__link">Decrypt &amp; Diagnose</a></li>
            <li><a href="/suture/sections/department-spotlight" class="footer__link">Department Spotlight</a></li>
            <li><a href="/suture/sections/healers-wellness" class="footer__link">Healers Wellness</a></li>
            <li><a href="/suture/sections/research-resource" class="footer__link">Research Resource</a></li>
            <li><a href="/suture/sections/world-health" class="footer__link">World Health</a></li>
          </ul>
        </div>

        <div class="footer__col">
          <p class="footer__col-label">Campus Chronicles</p>
          <ul role="list">
            <li><a href="/suture/campus-chronicles/clubs" class="footer__link">Clubs</a></li>
            <li><a href="/suture/campus-chronicles/cultural" class="footer__link">Cultural</a></li>
            <li><a href="/suture/campus-chronicles/ncc" class="footer__link">NCC</a></li>
            <li><a href="/suture/campus-chronicles/sports" class="footer__link">Sports</a></li>
            <li><a href="/suture/campus-chronicles/student-achievements" class="footer__link">Student Achievements</a></li>
            <li><a href="/suture/campus-chronicles/yrc" class="footer__link">YRC</a></li>
          </ul>
        </div>

        <div class="footer__col">
          <p class="footer__col-label">Beyond The Books</p>
          <ul role="list">
            <li><a href="/suture/beyond-the-books/artwork" class="footer__link">Artwork</a></li>
            <li><a href="/suture/beyond-the-books/creative-writing" class="footer__link">Creative Writing</a></li>
            <li><a href="/suture/beyond-the-books/photography" class="footer__link">Photography</a></li>
            <li><a href="/suture/beyond-the-books/poetry" class="footer__link">Poetry</a></li>
          </ul>
        </div>

        <div class="footer__col">
          <p class="footer__col-label">Publication</p>
          <ul role="list">
            <li><a href="/suture/about" class="footer__link">About</a></li>
            <li><a href="/suture/write-for-us" class="footer__link">Write for Us</a></li>
            <li><a href="/" class="footer__link">Literature Club</a></li>
          </ul>
        </div>

      </nav>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">
        &copy; {new Date().getFullYear()} The Suture. A publication of Literature Club.
      </p>
      <div class="footer__social" aria-label="Social media">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label="Follow The Suture on Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-16) var(--space-10);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--space-16);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-8);
  }

  .footer__logo-link {
    display: inline-block;
    margin-bottom: var(--space-3);
  }

  .footer__logo-img {
    height: 52px;
    width: auto;
    object-fit: contain;
    transition: opacity var(--dur-fast);
  }

  .footer__logo-link:hover .footer__logo-img {
    opacity: 0.8;
  }

  .footer__tagline {
    font-size: var(--fs-sm);
    color: var(--color-text-tertiary);
    line-height: var(--lh-relaxed);
    max-width: 200px;
  }

  /* Nav columns */
  .footer__nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
  }

  .footer__col-label {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--ls-widest);
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-4);
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__link {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    transition: color var(--dur-fast);
    padding-block: 2px;
  }
  .footer__link:hover { color: var(--color-text-primary); }

  /* Bottom row */
  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .footer__copy {
    font-size: var(--fs-xs);
    color: var(--color-text-tertiary);
  }

  .footer__social {
    display: flex;
    gap: var(--space-3);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-text-tertiary);
    transition:
      color var(--dur-fast),
      border-color var(--dur-fast),
      background var(--dur-fast);
  }
  .footer__social-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-muted);
    background: var(--color-accent-muted);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .footer__nav {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .footer__logo-img {
      height: 36px;
    }
    .footer__nav {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
