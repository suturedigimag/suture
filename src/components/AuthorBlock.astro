---
import { Image } from 'astro:assets';

interface Props {
  author?: string;
  authorPhoto?: string;
  date?: string;
}

const { author, authorPhoto, date } = Astro.props;
---

{(author || date) && (
  <div class="author-block">
    {authorPhoto && (
      <Image
        src={authorPhoto}
        alt={author ?? 'Author'}
        class="author-block__photo"
        loading="lazy"
        decoding="async"
        width={40}
        height={40}
      />
    )}
    <div class="author-block__text">
      {author && <span class="author-block__name">{author}</span>}
      {date && <span class="author-block__date">{date}</span>}
    </div>
  </div>
)}

<style>
  .author-block {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .author-block__photo {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border);
    flex-shrink: 0;
  }

  .author-block__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .author-block__name {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .author-block__date {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    color: var(--color-text-tertiary);
  }
</style>
