<!-- Nav scroll effect -->
<script>
  import { animate, stagger } from 'animejs';

  // 1. Navigation scroll effect
  const nav = document.getElementById('lc-nav');
  window.addEventListener('scroll', () => {
    nav?.classList.toggle('lc-nav--scrolled', window.scrollY > 60);
  }, { passive: true });

  // Mobile hamburger toggle for Literature Club nav
  const hamburger = document.getElementById('lc-nav-hamburger');
  const navLinks = document.querySelector('.lc-nav__links');
  
  hamburger?.addEventListener('click', () => {
    const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
    hamburger.setAttribute('aria-expanded', String(!isOpen));
    navLinks?.classList.toggle('lc-nav__links--open', !isOpen);
    hamburger.classList.toggle('lc-nav__hamburger--open', !isOpen);
  });

  navLinks?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      hamburger?.setAttribute('aria-expanded', 'false');
      navLinks.classList.remove('lc-nav__links--open');
      hamburger?.classList.remove('lc-nav__hamburger--open');
    });
  });

  // 2. Hero initial reveal with anime.js (staggered)
  animate('[data-hero-reveal]', {
    translateY: [48, 0],
    opacity: [0, 1],
    delay: stagger(150, { start: 200 }),
    duration: 1200,
    ease: 'easeOutExpo'
  });

  // 3. Scroll reveal with anime.js (IntersectionObserver based)
  const scrollElements = document.querySelectorAll('[data-reveal]');
  const scrollObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const target = entry.target as HTMLElement;
        const delayAttr = target.getAttribute('data-delay');
        const delay = delayAttr ? parseInt(delayAttr, 10) : 0;

        animate(target, {
          translateY: [32, 0],
          opacity: [0, 1],
          duration: 1000,
          delay: delay,
          ease: 'easeOutExpo'
        });
        scrollObserver.unobserve(target);
      }
    });
  }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });

  scrollElements.forEach((el) => {
    (el as HTMLElement).style.opacity = '0';
    scrollObserver.observe(el);
  });

  // 4. Interactive Carousel with anime.js
  const carousel = document.getElementById('lc-carousel');
  if (carousel) {
    const slides = carousel.querySelectorAll('.lc-carousel__slide');
    const prevBtn = carousel.querySelector('.lc-carousel__nav-btn.prev');
    const nextBtn = carousel.querySelector('.lc-carousel__nav-btn.next');
    let activeIndex = 0;
    let isAnimating = false;

    const showSlide = (nextIndex: number, direction: 'next' | 'prev') => {
      if (isAnimating || nextIndex === activeIndex) return;
      isAnimating = true;

      const currentSlide = slides[activeIndex];
      const nextSlide = slides[nextIndex];

      nextSlide.classList.add('active');
      const offset = direction === 'next' ? 120 : -120;
      
      // Animate current slide OUT
      animate(currentSlide, {
        opacity: [1, 0],
        translateX: [0, -offset],
        duration: 500,
        ease: 'easeInOutQuad',
        complete: () => {
          currentSlide.classList.remove('active');
          (currentSlide as HTMLElement).style.transform = '';
        }
      });

      // Animate next slide IN
      animate(nextSlide, {
        opacity: [0, 1],
        translateX: [offset, 0],
        duration: 500,
        ease: 'easeInOutQuad',
        complete: () => {
          activeIndex = nextIndex;
          isAnimating = false;
        }
      });
    };

    prevBtn?.addEventListener('click', () => {
      const nextIndex = (activeIndex - 1 + slides.length) % slides.length;
      showSlide(nextIndex, 'prev');
    });

    nextBtn?.addEventListener('click', () => {
      const nextIndex = (activeIndex + 1) % slides.length;
      showSlide(nextIndex, 'next');
    });

    // Auto play every 6 seconds
    setInterval(() => {
      if (!isAnimating) {
        const nextIndex = (activeIndex + 1) % slides.length;
        showSlide(nextIndex, 'next');
      }
    }, 6000);
  }
</script>

<style>
  /* ── Base ────────────────────────────────────────────────────── */
  .litclub-home {
    font-family: var(--font-sans);
    color: var(--color-text-primary);
    background: var(--color-bg);
  }

  /* ── Nav ─────────────────────────────────────────────────────── */
  .lc-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 900;
    transition: background var(--dur-normal), box-shadow var(--dur-normal), border-color var(--dur-normal);
    border-bottom: 1px solid transparent;
  }
  .lc-nav--scrolled {
    background: rgba(250,250,248,0.95);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-sm);
  }
  .lc-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    height: 80px;
    gap: var(--space-8);
  }
  .lc-nav__logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: var(--ls-tight);
    color: var(--color-text-primary);
    transition: color var(--dur-fast);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .lc-nav__logo-img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .lc-nav__logo-text {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
  }
  .lc-nav__logo:hover { color: var(--color-accent); }
  .lc-nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex: 1;
    justify-content: center;
  }
  .lc-nav__link {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    transition: color var(--dur-fast), background var(--dur-fast);
  }
  .lc-nav__link:hover { color: var(--color-text-primary); background: var(--color-surface-hover); }
  .lc-nav__cta {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-text-primary);
    border: 1.5px solid var(--color-text-primary);
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    flex-shrink: 0;
    transition: background var(--dur-fast), color var(--dur-fast);
  }
  .lc-nav__cta:hover { background: var(--color-text-primary); color: var(--color-bg); }

  /* ── Hero ────────────────────────────────────────────────────── */
  .lc-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 64px;
    overflow: hidden;
  }
  .lc-hero__bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #1a1a18 0%, #2d2b27 40%, #1a1814 100%);
  }
  .lc-hero__gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 70% 50%, rgba(193,18,31,0.08) 0%, transparent 60%);
  }
  .lc-hero__content {
    position: relative;
    z-index: 2;
    padding-block: var(--space-20);
  }
  .lc-hero__overline { color: var(--color-accent); margin-bottom: var(--space-5); }
  .lc-hero__title {
    font-family: var(--font-serif);
    font-size: var(--fs-4xl);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #FAFAF8;
    margin-bottom: var(--space-6);
    max-width: 700px;
  }
  .lc-hero__sub {
    font-size: var(--fs-lg);
    line-height: var(--lh-relaxed);
    color: rgba(250,250,248,0.6);
    max-width: 520px;
    margin-bottom: var(--space-10);
  }
  .lc-hero__actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .lc-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-base);
