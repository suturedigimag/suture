---
/**
 * Literature Club — Main Homepage (Root Index)
 * Route: /suture/ (or root under base path /suture)
 *
 * This is the parent site. The Suture lives at /suture/suture.
 */
import '../styles/global.css';
import { getEvents } from '../lib/cms';

const title = 'PSG Lit Club | Coimbatore';
const description = "It's PSGIMSR's very own Literature and Arts club!";

const events = await getEvents(6);
---

<!doctype html>
<html lang="en">
