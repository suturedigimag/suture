---
export const prerender = false;

/**
 * Suture Home — The Suture Editorial Publication
 * Route: /suture/suture
 */
import PageLayout from '../../layouts/PageLayout.astro';
import SutureHero from '../../components/SutureHero.astro';
import FeaturedStory from '../../components/FeaturedStory.astro';
import MagazineGrid from '../../components/MagazineGrid.astro';
import SectionTicker from '../../components/SectionTicker.astro';
import InstagramWall from '../../components/InstagramWall.astro';
import SubmissionCTA from '../../components/SubmissionCTA.astro';
import {
  getMostRecentArticle,
  getArticles,
  getArticleUrl,
  COLLECTION_IDS,
} from '../../lib/cms';

// Parallel data fetch — all sections at once
const [
  heroArticle,
  sectionsAllRaw,
  campusChroniclesAllRaw,
  worldHealthRaw,
  beyondTheBooksAllRaw,
] = await Promise.all([
  getMostRecentArticle(),
  // Clinicals — clinical medicine, diagnostics, department spotlight, wellness & research
  Promise.all([
    getArticles(COLLECTION_IDS.clinicalCaseCorner, 6),
    getArticles(COLLECTION_IDS.decryptAndDiagnose, 2),
    getArticles(COLLECTION_IDS.departmentSpotlight, 2),
    getArticles(COLLECTION_IDS.healersWellness, 2),
    getArticles(COLLECTION_IDS.researchResource, 2),
  ]).then(([a, b, c, d, e]) => [...a, ...b, ...c, ...d, ...e]),
  // Campus Chronicles
  Promise.all([
    getArticles(COLLECTION_IDS.clubs, 3),
    getArticles(COLLECTION_IDS.cultural, 3),
    getArticles(COLLECTION_IDS.sports, 2),
    getArticles(COLLECTION_IDS.ncc, 2),
    getArticles(COLLECTION_IDS.studentAchievements, 2),
    getArticles(COLLECTION_IDS.yrc, 2),
  ]).then(([a, b, c, d, e, f]) => [...a, ...b, ...c, ...d, ...e, ...f]),
  // World Health
  getArticles(COLLECTION_IDS.worldHealth, 6),
  // Beyond The Books
  Promise.all([
    getArticles(COLLECTION_IDS.artwork, 3),
    getArticles(COLLECTION_IDS.creativeWriting, 3),
    getArticles(COLLECTION_IDS.photography, 3),
    getArticles(COLLECTION_IDS.poetry, 3),
  ]).then(([a, b, c, d]) => [...a, ...b, ...c, ...d]),
]);

// Sort arrays by date descending
const sectionsAll = [...sectionsAllRaw].sort(
  (a, b) => new Date(b._createdDate).getTime() - new Date(a._createdDate).getTime()
);

const campusChroniclesAll = [...campusChroniclesAllRaw].sort(
  (a, b) => new Date(b._createdDate).getTime() - new Date(a._createdDate).getTime()
);

const worldHealth = [...worldHealthRaw].sort(
  (a, b) => new Date(b._createdDate).getTime() - new Date(a._createdDate).getTime()
);

const beyondTheBooksAll = [...beyondTheBooksAllRaw].sort(
  (a, b) => new Date(b._createdDate).getTime() - new Date(a._createdDate).getTime()
);

// Featured = second article overall (hero takes first)
const allRecent = [...sectionsAll, ...campusChroniclesAll, ...worldHealth, ...beyondTheBooksAll].sort(
  (a, b) => new Date(b._createdDate).getTime() - new Date(a._createdDate).getTime()
);
const featuredArticle = allRecent.find(
  (a) => a._id !== heroArticle?._id
) ?? allRecent[0] ?? null;
---

<PageLayout
  title="The Suture"
  description="The independent editorial publication of Literature Club — medicine, campus life, and creative expression."
>

  <!-- 1. Cinematic Hero with Particle Background and Typography Effects -->
  <SutureHero />

  <!-- 2. Featured Story -->
  {featuredArticle && (
    <FeaturedStory
      article={featuredArticle}
      href={getArticleUrl(featuredArticle)}
      sectionLabel="Featured"
    />
  )}

  <!-- 3. Section ticker -->
  <SectionTicker />

  <!-- 4. Clinicals — Magazine Grid -->
  {sectionsAll.length > 0 && (
    <section class="home-section section-py" aria-labelledby="clinicals-heading">
      <div class="container">
        <div class="home-section__header" data-reveal>
          <div class="home-section__title-block">
            <h2 class="home-section__title" id="clinicals-heading">Clinicals</h2>
            <p class="home-section__description">In-depth writing on clinical medicine, diagnostic puzzles, wellness, and research.</p>
          </div>
          <a href="/suture/sections" class="home-section__view-all">
            View All
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <hr class="divider" />
        <MagazineGrid articles={sectionsAll} sectionLabel="Clinicals" />
      </div>
    </section>
  )}

  <!-- 5. Campus Chronicles — Magazine Grid -->
  {campusChroniclesAll.length > 0 && (
    <section class="home-section section-py" aria-labelledby="campus-chronicles-heading">
      <div class="container">
        <div class="home-section__header" data-reveal>
          <div class="home-section__title-block">
            <h2 class="home-section__title" id="campus-chronicles-heading">Campus Chronicles</h2>
            <p class="home-section__description">The pulse of the campus. Find out about the latest events, sports tournaments, club meets, and student life inside PSG IMSR.</p>
          </div>
          <a href="/suture/campus-chronicles" class="home-section__view-all">
            View All
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <hr class="divider" />
        <MagazineGrid articles={campusChroniclesAll} sectionLabel="Campus Chronicles" />
      </div>
    </section>
  )}

  <!-- 6. World Health — Magazine Grid -->
  {worldHealth.length > 0 && (
    <section class="home-section section-py" aria-labelledby="world-health-heading">
      <div class="container">
        <div class="home-section__header" data-reveal>
          <div class="home-section__title-block">
            <h2 class="home-section__title" id="world-health-heading">World Health</h2>
            <p class="home-section__description">Stay informed on global health milestones, clinical breakthroughs, and days of international medical significance.</p>
          </div>
          <a href="/suture/sections/world-health" class="home-section__view-all">
            View All
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <hr class="divider" />
        <MagazineGrid articles={worldHealth} sectionLabel="World Health" />
      </div>
    </section>
  )}

  <!-- 7. Beyond The Books — Magazine Grid -->
  {beyondTheBooksAll.length > 0 && (
    <section class="home-section section-py" aria-labelledby="beyond-the-books-heading">
      <div class="container">
        <div class="home-section__header" data-reveal>
          <div class="home-section__title-block">
            <h2 class="home-section__title" id="beyond-the-books-heading">Beyond The Books</h2>
            <p class="home-section__description">Time to drop the textbooks and explore your creative side — showcasing the artistic, poetic, and photographic talents of PSG IMSR.</p>
          </div>
          <a href="/suture/beyond-the-books" class="home-section__view-all">
            View All
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <hr class="divider" />
        <MagazineGrid articles={beyondTheBooksAll} sectionLabel="Beyond The Books" />
      </div>
    </section>
  )}

  <!-- 8. Section ticker (second instance) -->
  <SectionTicker />

  <!-- 9. Instagram Wall -->
  <InstagramWall />

  <!-- 10. Submission CTA -->
  <SubmissionCTA />

</PageLayout>

<style>
  .home-welcome {
    text-align: center;
    background: var(--color-surface-hover);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .home-welcome__text {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    line-height: var(--lh-relaxed);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
    font-weight: 400;
  }

  .home-welcome__sub {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    max-width: 500px;
    margin-inline: auto;
  }

  .home-section__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .home-section__title-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .home-section__title {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    font-weight: 700;
    letter-spacing: var(--ls-tight);
    margin: 0;
  }

  .home-section__description {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
    max-width: 600px;
    margin: 0;
  }

  .home-section__view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-accent);
    white-space: nowrap;
    transition: gap var(--dur-fast);
  }
  .home-section__view-all:hover { gap: var(--space-3); }
</style>
