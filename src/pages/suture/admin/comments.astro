---
/**
 * /suture/admin/comments — Editorial Comments Moderation Dashboard
 * SSR: Always verifies admin session server-side
 */
export const prerender = false;

import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { getVerifiedMember } from '../../../lib/wix-auth';
import { queryAdminComments } from '../../../lib/wix-comments';

const member = await getVerifiedMember(Astro.cookies);

// Strict server-side verification: Redirect or block if not an admin
if (!member || !member.isAdmin) {
  return Astro.redirect('/api/auth/login?redirect=' + encodeURIComponent(Astro.url.pathname));
}

let comments: any[] = [];
let queryError = '';

try {
  comments = await queryAdminComments({ limit: 100 });
} catch (err: any) {
  queryError = err.message || 'Failed to load comments from Wix API.';
}
---

<Base title="Comments Moderation — The Suture">
  <Nav />

  <main id="main-content" class="admin-page section-py">
    <div class="container">
      <header class="admin-header" data-reveal>
        <p class="eyebrow">Editorial Moderation</p>
        <h1 class="admin-title">Comments Discussion Dashboard</h1>
        <p class="admin-desc">
          Manage and moderate reader discussions across all published articles in The Suture.
          Logged in as <strong>{member.name}</strong> ({member.email}).
        </p>
      </header>

      {queryError && (
        <div class="admin-alert admin-alert--error" role="alert">
          <p><strong>Note:</strong> {queryError}</p>
          <p style="font-size: 0.85rem; margin-top: 4px;">
            Ensure the Headless Client ID has the "Read Comments" and "Manage Comments" permissions enabled in your Wix Dev Center dashboard.
          </p>
        </div>
      )}

      <div class="admin-toolbar">
        <input
          type="text"
          id="admin-search"
          placeholder="Filter by comment text, author, or article ID..."
          class="admin-search-input"
        />
        <span class="admin-count"><strong id="visible-count">{comments.length}</strong> comments total</span>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Status</th>
              <th>Article ID</th>
              <th>Author Member ID</th>
              <th>Content</th>
              <th>Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="comments-tbody">
            {comments.length === 0 ? (
              <tr>
                <td colspan="6" class="empty-state">
                  No comments currently recorded, or Wix Comments API permissions need configuration.
                </td>
              </tr>
            ) : (
              comments.map((c) => (
                <tr id={`row-${c.id}`} class="comment-row" data-search={`${c.content} ${c.articleId} ${c.authorMemberId}`.toLowerCase()}>
                  <td>
                    <span class={`status-badge status-badge--${c.status.toLowerCase()}`}>
                      {c.status}
                    </span>
                  </td>
                  <td>
                    <code class="code-id">{c.articleId || '—'}</code>
                  </td>
                  <td>
                    <code class="code-id">{c.authorMemberId || '—'}</code>
                  </td>
                  <td class="content-cell">
                    <p class="comment-text">{c.content}</p>
                    {c.parentCommentId && (
                      <span class="reply-indicator">↳ Reply to: {c.parentCommentId}</span>
                    )}
                  </td>
                  <td class="date-cell">
                    {c.createdDate ? new Date(c.createdDate).toLocaleDateString('en-IN', {
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric',
                      hour: '2-digit',
                      minute: '2-digit'
                    }) : '—'}
                  </td>
                  <td>
                    {c.status !== 'DELETED' ? (
                      <button
                        type="button"
                        class="btn-delete"
                        data-delete-id={c.id}
                        title="Delete comment permanently"
                      >
                        Delete
                      </button>
                    ) : (
                      <span class="deleted-label">Removed</span>
                    )}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <Footer />
</Base>

<script>
  // Filter comments in real time
  const searchInput = document.getElementById('admin-search') as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll('.comment-row')) as HTMLElement[];
  const countEl = document.getElementById('visible-count');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase().trim();
    let visible = 0;
    rows.forEach((row) => {
      const text = row.getAttribute('data-search') || '';
      if (!query || text.includes(query)) {
        row.style.display = '';
        visible++;
      } else {
        row.style.display = 'none';
      }
    });
    if (countEl) countEl.textContent = String(visible);
  });

  // Handle comment deletion by admin
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('[data-delete-id]') as HTMLButtonElement | null;
    if (!btn) return;

    const commentId = btn.getAttribute('data-delete-id');
    if (!commentId) return;

    const confirmed = window.confirm('Are you sure you want to delete this comment? This action is permanent.');
    if (!confirmed) return;

    btn.disabled = true;
    btn.textContent = 'Deleting...';

    try {
      const res = await fetch(`/api/comments/${commentId}`, {
        method: 'DELETE',
        headers: { 'Accept': 'application/json' },
      });

      if (res.ok) {
        const row = document.getElementById(`row-${commentId}`);
        if (row) {
          const badge = row.querySelector('.status-badge');
          if (badge) {
            badge.className = 'status-badge status-badge--deleted';
            badge.textContent = 'DELETED';
          }
          btn.replaceWith(document.createTextNode('Removed'));
        }
      } else {
        const data = await res.json().catch(() => ({}));
        alert(data.error || 'Failed to delete comment.');
        btn.disabled = false;
        btn.textContent = 'Delete';
      }
    } catch {
      alert('Network error while deleting comment.');
      btn.disabled = false;
      btn.textContent = 'Delete';
    }
  });
</script>

<style>
  .admin-page {
    padding-top: calc(var(--section-py) + 40px);
    background: var(--color-bg);
    min-height: 80vh;
  }

  .admin-header {
    margin-bottom: var(--space-8);
  }

  .admin-title {
    font-family: var(--font-serif);
    font-size: var(--fs-2xl);
    color: var(--color-text-primary);
    margin-block: var(--space-2) var(--space-3);
  }

  .admin-desc {
    color: var(--color-text-secondary);
    font-size: var(--fs-sm);
  }

  .admin-alert {
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
    font-size: var(--fs-sm);
  }

  .admin-alert--error {
    background: #FEF2F2;
    border: 1px solid #FCA5A5;
    color: #991B1B;
  }

  .admin-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .admin-search-input {
    flex: 1;
    min-width: 280px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    color: var(--color-text-primary);
  }

  .admin-search-input:focus {
    border-color: var(--color-accent);
    outline: none;
  }

  .admin-count {
    font-size: var(--fs-xs);
    color: var(--color-text-tertiary);
  }

  .admin-table-wrap {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    box-shadow: var(--shadow-sm);
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    text-align: left;
  }

  .admin-table th {
    padding: var(--space-4);
    background: var(--color-surface-hover);
    color: var(--color-text-secondary);
    font-weight: 600;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-wider);
    border-bottom: 1px solid var(--color-border);
  }

  .admin-table td {
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }

  .code-id {
    font-family: monospace;
    font-size: var(--fs-xs);
    background: var(--color-surface-hover);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    word-break: break-all;
  }

  .content-cell {
    max-width: 320px;
  }

  .comment-text {
    line-height: var(--lh-snug);
    color: var(--color-text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .reply-indicator {
    display: block;
    margin-top: 4px;
    font-size: var(--fs-xs);
    color: var(--color-text-tertiary);
  }

  .date-cell {
    font-size: var(--fs-xs);
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }

  .status-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: var(--fs-xs);
    font-weight: 500;
    text-transform: uppercase;
  }

  .status-badge--published { background: #ECFDF5; color: #065F46; }
  .status-badge--deleted { background: #FEF2F2; color: #991B1B; }
  .status-badge--pending { background: #FFFBEB; color: #92400E; }
  .status-badge--hidden { background: #F3F4F6; color: #4B5563; }

  .btn-delete {
    color: var(--color-accent);
    font-weight: 500;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    transition: background var(--dur-fast);
  }

  .btn-delete:hover {
    background: var(--color-accent-muted);
  }

  .deleted-label {
    color: var(--color-text-tertiary);
    font-style: italic;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-12) !important;
    color: var(--color-text-tertiary);
  }
</style>
