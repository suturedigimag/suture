---
/**
 * Sections index — /suture/sections
 * Lists all editorial sub-sections with a preview.
 */
import PageLayout from '../../../layouts/PageLayout.astro';
import EditorialCard from '../../../components/EditorialCard.astro';
import {
  getArticles,
  COLLECTION_NAMES,
  SECTION_ROUTE_MAP,
} from '../../../lib/cms';

const sectionEntries = Object.entries(SECTION_ROUTE_MAP);

const SECTION_DESCRIPTIONS: Record<string, string> = {
  'clinical-case-corner':  'Dive into rare cases, clinical dilemmas and case reports prepared by your own peers and seniors. Check out the latest findings and clinical reports to broaden your medical scope and keep you on track.',
  'decrypt-and-diagnose':  'Put your clinical acumen to a challenge with these medical cases and diagnostic dilemmas. Review the reports, analyze the clues and choose the right diagnosis. Learn more about the underlying pathologies as you solve these clinical cases!',
  'department-spotlight':  'We take an exclusive look at the inner workings of a department in PSG IMSR. We bring forward to you what happens on daily basis, their routines and their goals. For this first edition, we have shadowed the Department of Forensic Medicine.',
  'healers-wellness':      'Take a breath and step back. The stress of medical life can be overwhelming. Find some tips, stories, resources and advice on how to handle burnouts, stress and manage wellness as a medical student.',
  'research-resource':     'Anxious to get a few publications out? Or stuck with a project topic? Check out this resource section to get a brief idea of the research opportunities, how to publish and tips from your seniors and professors.',
  'world-health':          'Stay informed on the history and significance of major global health events with this section. Every edition focuses on a particular day of significance and this edition brings forward the World Organ Transplantation day - August 13 2026.',
};

// Fetch one article from each sub-section for preview
const previews = await Promise.all(
  sectionEntries.map(async ([slug, collectionId]) => {
    const articles = await getArticles(collectionId, 1);
    return { slug, name: COLLECTION_NAMES[slug] ?? slug, article: articles[0] ?? null };
  })
);
---

<PageLayout
  title="Sections"
  description="Editorial content from The Suture — clinical medicine, department spotlights, wellness, research, and world health."
>
  <div class="section-index section-py" style="padding-top: calc(var(--section-py) + 64px);">
    <div class="container">

      <header class="section-index__header" data-reveal>
        <p class="eyebrow">Editorial</p>
        <h1 class="section-index__title">Sections</h1>
        <p class="section-index__desc">
          In-depth writing on clinical medicine, public health, research, and wellbeing.
        </p>
      </header>

      <hr class="divider" />

      <div class="section-index__grid">
        {previews.map(({ slug, name, article }, i) => (
          <div class="section-index__group" data-reveal data-delay={String(i * 80)}>
            <a href={`/suture/sections/${slug}`} class="section-index__section-link">
              <h2 class="section-index__section-name">{name}</h2>
              <span class="section-index__arrow" aria-hidden="true">→</span>
            </a>
            {SECTION_DESCRIPTIONS[slug] && (
              <p class="section-index__section-desc">{SECTION_DESCRIPTIONS[slug]}</p>
            )}
            {article && (
              <EditorialCard
                article={article}
                href={`/suture/sections/${slug}/${article.slug}`}
                variant="compact"
              />
            )}
          </div>
        ))}
      </div>

    </div>
  </div>
</PageLayout>

<style>
  .section-index__header {
    max-width: 600px;
    margin-bottom: var(--space-10);
  }

  .section-index__header .eyebrow {
    margin-bottom: var(--space-4);
  }

  .section-index__title {
    font-family: var(--font-serif);
    font-size: var(--fs-3xl);
    font-weight: 700;
    letter-spacing: var(--ls-tight);
    margin-bottom: var(--space-4);
  }

  .section-index__desc {
    font-size: var(--fs-md);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
  }

  .section-index__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-8);
    margin-top: var(--space-10);
  }

  .section-index__section-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--color-text-primary);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-4);
    transition: color var(--dur-fast);
  }

  .section-index__section-link:hover { color: var(--color-accent); }
  .section-index__arrow { transition: transform var(--dur-fast); }
  .section-index__section-link:hover .section-index__arrow { transform: translateX(4px); }

  .section-index__section-desc {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
    margin-top: 0;
    margin-bottom: var(--space-4);
  }
</style>
