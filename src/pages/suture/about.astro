---
export const prerender = false;

import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import { getAboutMembers, getDesignTeamMembers, getPhotoTeamMembers } from '../../lib/cms';
import InstagramWall from '../../components/InstagramWall.astro';

const boardMembers = await getAboutMembers();
const designMembers = await getDesignTeamMembers();
const photoMembers = await getPhotoTeamMembers();
---

<PageLayout
  title="About"
  description="The Suture is the independent editorial publication of Literature Club — sharing stories from medicine, campus life, and creative expression."
>
  <div class="about-page" style="padding-top: 64px;">

    <div class="about-page__banner">
      <div class="container">
        <p class="eyebrow" data-reveal>About</p>
        <h1 class="about-page__title" data-reveal data-delay="100">The Suture</h1>
      </div>
    </div>

    <div class="container--narrow section-py">
      <div class="about-page__body" data-reveal>
        <p class="about-page__lead">
          The Suture is the independent editorial publication of Literature Club —
          a student-run journal at the intersection of medicine, campus life, and creative expression.
        </p>

        <p>
          We believe in the power of storytelling within the medical college community.
          From clinical case discussions and research summaries to poetry and photography,
          The Suture is a space where every student voice matters.
        </p>

        <h2>Our Sections</h2>
        <ul class="about-page__sections">
          <li><strong>Clinical Case Corner</strong> — Real cases, rare diagnoses, educational insights.</li>
          <li><strong>Decrypt &amp; Diagnose</strong> — Medical puzzles and diagnostic reasoning.</li>
          <li><strong>Department Spotlight</strong> — Highlighting the people and work within each department.</li>
          <li><strong>Healers Wellness</strong> — Mental health, wellbeing, and balance in medicine.</li>
          <li><strong>Research Resource</strong> — Student research, methodology, and academic writing.</li>
          <li><strong>World Health</strong> — Global health issues and public health perspectives.</li>
          <li><strong>Campus Chronicles</strong> — Clubs, cultural events, NCC, sports, and student life.</li>
          <li><strong>Beyond The Books</strong> — Artwork, photography, creative writing, and poetry.</li>
        </ul>

        <h2>Write for Us</h2>
        <p>
          The Suture welcomes contributions from all students of Literature Club.
          Whether you have a clinical reflection, a piece of research, or a poem — we want to hear from you.
          For submissions, questions, or comments, you can contact us directly at <a href="mailto:suturedigimag@psgimsr.ac.in" style="color: var(--color-accent); text-decoration: underline; font-weight: 500;">suturedigimag@psgimsr.ac.in</a>.
        </p>

        <a href="/suture/write-for-us" class="about-page__cta">
          Submit an Article →
        </a>
      </div>
    </div>

    <!-- ── Our Board Section ────────────────────────────────────── -->
    {boardMembers.length > 0 && (
      <section class="about-board section-py" id="board">
        <div class="container">
          <div class="about-board__header" data-reveal>
            <p class="eyebrow">The People</p>
            <h2 class="about-board__title">Our Board</h2>
            <p class="about-board__sub">The minds behind Literature Club and The Suture.</p>
          </div>

          <div class="about-board__grid">
            {boardMembers.map((member, i) => (
              <div class="about-board__card" data-reveal data-delay={Math.min(i * 80, 400)}>
                <div class="about-board__card-photo-wrap">
                  {member.photo ? (
                    <Image src={member.photo} alt={member.name} width={500} height={500} class="about-board__card-photo" loading="lazy" decoding="async" />
                  ) : (
                    <div class="about-board__card-photo-fallback">
                      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                      </svg>
                    </div>
                  )}
                </div>
                <div class="about-board__card-content">
                  <h3 class="about-board__card-name">{member.name}</h3>
                  <p class="about-board__card-role">{member.role}</p>
                  {member.bio && <p class="about-board__card-bio">{member.bio}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Design Team Section ──────────────────────────────────── -->
    {designMembers.length > 0 && (
      <section class="about-board section-py" id="design-team" style="border-top: none;">
        <div class="container">
          <div class="about-board__header" data-reveal>
            <p class="eyebrow">Creative Direction</p>
            <h2 class="about-board__title">Design Team</h2>
            <p class="about-board__sub">Crafting the visual identity, typography, and layout of The Suture.</p>
          </div>

          <div class="about-board__grid">
            {designMembers.map((member, i) => (
              <div class="about-board__card" data-reveal data-delay={Math.min(i * 80, 400)}>
                <div class="about-board__card-photo-wrap">
                  {member.photo ? (
                    <Image src={member.photo} alt={member.name} width={500} height={500} class="about-board__card-photo" loading="lazy" decoding="async" />
                  ) : (
                    <div class="about-board__card-photo-fallback">
                      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                      </svg>
                    </div>
                  )}
                </div>
                <div class="about-board__card-content">
                  <h3 class="about-board__card-name">{member.name}</h3>
                  <p class="about-board__card-role">{member.role}</p>
                  {member.bio && <p class="about-board__card-bio">{member.bio}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Photo Team Section ───────────────────────────────────── -->
    {photoMembers.length > 0 && (
      <section class="about-board section-py" id="photo-team" style="border-top: none;">
        <div class="container">
          <div class="about-board__header" data-reveal>
            <p class="eyebrow">Visual Storytelling</p>
            <h2 class="about-board__title">Photo Team</h2>
            <p class="about-board__sub">Capturing moments, imagery, and visual perspectives across campus and medicine.</p>
          </div>

          <div class="about-board__grid">
            {photoMembers.map((member, i) => (
              <div class="about-board__card" data-reveal data-delay={Math.min(i * 80, 400)}>
                <div class="about-board__card-photo-wrap">
                  {member.photo ? (
                    <Image src={member.photo} alt={member.name} width={500} height={500} class="about-board__card-photo" loading="lazy" decoding="async" />
                  ) : (
                    <div class="about-board__card-photo-fallback">
                      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                      </svg>
                    </div>
                  )}
                </div>
                <div class="about-board__card-content">
                  <h3 class="about-board__card-name">{member.name}</h3>
                  <p class="about-board__card-role">{member.role}</p>
                  {member.bio && <p class="about-board__card-bio">{member.bio}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Instagram Wall ───────────────────────────────────────── -->
    <section class="lc-instagram section-py" id="instagram" aria-labelledby="instagram-heading">
    <InstagramWall />
    </section>

  </div>
</PageLayout>

<style>
  .about-page__banner {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-12) var(--space-10);
  }

  .about-page__banner .eyebrow { margin-bottom: var(--space-3); }

  .about-page__title {
    font-family: var(--font-serif);
    font-size: var(--fs-3xl);
    font-weight: 700;
    letter-spacing: var(--ls-tight);
  }

  .about-page__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about-page__lead {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: var(--color-text-primary);
    font-weight: 400;
  }

  .about-page__body p {
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--color-text-secondary);
  }

  .about-page__body h2 {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    font-weight: 700;
    margin-top: var(--space-4);
    color: var(--color-text-primary);
  }

  .about-page__sections {
    list-style: disc;
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .about-page__sections li {
    font-size: var(--fs-base);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
  }

  .about-page__cta {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: var(--fs-base);
    font-weight: 500;
    color: var(--color-accent);
    transition: gap var(--dur-fast);
    margin-top: var(--space-2);
  }
  .about-page__cta:hover { color: var(--color-accent-hover); }

  /* ── Our Board Section ────────────────────────────────────── */
  .about-board {
    background: var(--color-surface-hover);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .about-board__header {
    margin-bottom: var(--space-10);
    text-align: center;
  }

  .about-board__title {
    font-family: var(--font-serif);
    font-size: var(--fs-2xl);
    font-weight: 700;
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .about-board__sub {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    max-width: 500px;
    margin-inline: auto;
  }

  .about-board__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--space-8);
  }

  .about-board__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--dur-normal) var(--ease-out-expo), box-shadow var(--dur-normal) var(--ease-out-expo);
  }

  .about-board__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .about-board__card-photo-wrap {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-surface-hover);
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }

  .about-board__card-photo-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-hover);
    color: var(--color-text-tertiary);
  }

  .about-board__card-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }

  .about-board__card:hover .about-board__card-photo {
    transform: scale(1.03);
  }

  .about-board__card-content {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .about-board__card-name {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .about-board__card-role {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-wider);
    color: var(--color-accent);
  }

  .about-board__card-bio {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
  }

  /* ── Instagram Section ────────────────────────────────────── */
  .about-instagram {
    background: var(--color-surface);
  }
</style>
