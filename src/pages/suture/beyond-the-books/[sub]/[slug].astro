---
/**
 * Beyond The Books article page — /suture/beyond-the-books/[sub]/[slug]
 * SSR: always fresh from CMS
 */
export const prerender = false;

import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import { getArticleBySlug, getArticles, renderRichContent, BOOKS_ROUTE_MAP, COLLECTION_NAMES } from '../../../../lib/cms';

const { sub, slug } = Astro.params as { sub: string; slug: string };

const collectionId = BOOKS_ROUTE_MAP[sub];
if (!collectionId) return Astro.redirect('/suture/beyond-the-books');

const [article, relatedRaw] = await Promise.all([
  getArticleBySlug(collectionId, slug),
  getArticles(collectionId, 4),
]);

if (!article) return Astro.redirect('/suture/beyond-the-books/' + sub);

const related = relatedRaw.filter((a) => a.slug !== slug);
const sectionName = COLLECTION_NAMES[sub] ?? sub;
---

<ArticleLayout
  article={article}
  relatedArticles={related}
  sectionName={sectionName}
  sectionHref={`/suture/beyond-the-books/${sub}`}
>
  {article.body ? (
    <div set:html={renderRichContent(article.body)} />
  ) : (
    <p style="color: var(--color-text-tertiary);">Article content is not available.</p>
  )}
</ArticleLayout>
