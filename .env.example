# ==============================================================================
# The Suture — Environment Variables Configuration
# Copy this file to .env and provide your actual values.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ── Wix Headless Authentication & CMS ─────────────────────────────────────────
# Existing OAuth Client ID from Wix Dev Center (Settings > Headless)
# Public application identifier used for member authentication and CMS queries
WIX_CLIENT_ID=your-existing-wix-client-id

# ── Wix Headless Comments Configuration ───────────────────────────────────────
# Application ID for Comments. Defaults to standard Wix Blog / Comments app GUID:
# 14bcded7-0066-7c35-14d7-466cb3f09103 (Blog comments)
# 91c9d6a7-6667-41fb-b0b4-7d3b3ff0b02e (Custom Wix Comments App)
WIX_COMMENTS_APP_ID=14bcded7-0066-7c35-14d7-466cb3f09103

# Context / Category ID for The Suture comments.
# Discovered live category ID: 059aa884-79a4-41b5-9466-ab6839685cbf
WIX_COMMENTS_CONTEXT_ID=059aa884-79a4-41b5-9466-ab6839685cbf

# ── Server-Side Administrative Moderation (Optional) ─────────────────────────
# Comma-separated list of member login emails permitted to moderate comments
ADMIN_EMAILS=editor@example.com,admin@example.com

# Wix API Key (Optional — for server-to-server elevated moderation tasks)
# Generated in Wix Studio / Wix Dashboard > Settings > API Keys
# Scope required: Manage Comments, Read Comments
WIX_API_KEY=

# Wix Site ID (Optional — required only if WIX_API_KEY is configured)
# Found in Wix Dashboard URL or Site Settings
WIX_SITE_ID=

# ── Additional Integrations ───────────────────────────────────────────────────
# Instagram Basic Display Access Token (existing widget integration)
INSTAGRAM_ACCESS_TOKEN=
